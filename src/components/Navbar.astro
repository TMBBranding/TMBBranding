---
import { getEntry } from 'astro:content';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const settingsEntry = await getEntry('pages', 'settings');
const settings = settingsEntry?.data;
const phone = settings?.phone || "+1 512 529 1677";
const location = settings?.location || "International";
const brandName = settings?.brandName || "TMB BRANDING";

const defaultNavItems = [
  { label: 'Services', href: '/services' },
  { label: 'Brands', href: '/brands' },
  { label: 'About Us', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const navItems = (settings?.navItems && settings.navItems.length > 0)
  ? settings.navItems
  : defaultNavItems;

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<header
  id="site-header"
  class="sticky top-0 z-50 bg-creme-powder/90 backdrop-blur-md transition-transform duration-300 ease-in-out"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="inline-flex items-center focus:outline-none" aria-label={brandName}>
      <span class="font-sans text-[11px] uppercase tracking-luxury font-medium text-espresso">
        {brandName}
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-9 lg:space-x-11" aria-label="Main Navigation">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`text-[11px] uppercase tracking-luxury font-medium transition-colors duration-300 relative py-1.5 ${
              active
                ? 'text-espresso font-semibold'
                : 'text-taupe hover:text-espresso'
            }`}
          >
            {item.label}
            {active && (
              <span class="absolute bottom-0 left-0 right-[0.35em] h-[1.5px] bg-espresso"></span>
            )}
          </a>
        );
      })}
    </nav>

    <!-- Mobile Menu Trigger Button -->
    <button
      id="navbar-toggle-btn"
      type="button"
      class="md:hidden p-2.5 -mr-2 text-espresso hover:text-taupe focus:outline-none transition-colors"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="navbar-mobile-drawer"
    >
      <!-- Hamburger Icon -->
      <svg id="navbar-icon-hamburger" class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
      <!-- Close (X) Icon -->
      <svg id="navbar-icon-close" class="hidden w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Mobile Navigation Drawer (Full-Screen Overlay with its own fixed top bar & close button) -->
<div
  id="navbar-mobile-drawer"
  class="hidden md:hidden fixed inset-0 z-50 bg-creme-powder flex flex-col animate-mobile-drawer"
>
  <!-- Dedicated Drawer Top Bar with Brand Logo & Close (X) Button -->
  <div class="h-14 sm:h-16 px-6 sm:px-8 flex items-center justify-between border-b border-creme-border/60 flex-shrink-0 bg-creme-powder">
    <a href="/" class="inline-flex items-center focus:outline-none" aria-label={brandName}>
      <span class="font-sans text-[11px] uppercase tracking-luxury font-medium text-espresso">
        {brandName}
      </span>
    </a>

    <button
      id="navbar-drawer-close-btn"
      type="button"
      class="p-2.5 -mr-2 text-espresso hover:text-taupe focus:outline-none transition-colors"
      aria-label="Close menu"
    >
      <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Navigation Links Only (Clean, Minimalist & Focused) -->
  <div class="px-6 sm:px-8 py-10 sm:py-12 flex flex-col flex-grow justify-start overflow-y-auto">
    <nav class="flex flex-col space-y-6 sm:space-y-7" aria-label="Mobile Navigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`font-serif text-3xl sm:text-4xl transition-colors duration-300 ${
            isActive(item.href)
              ? 'text-espresso italic font-normal'
              : 'text-taupe hover:text-espresso'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<style>
  @keyframes mobileDrawerFadeIn {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-mobile-drawer {
    animation: mobileDrawerFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>

<script is:inline>
  const navBtn = document.getElementById('navbar-toggle-btn');
  const navDrawer = document.getElementById('navbar-mobile-drawer');
  const drawerCloseBtn = document.getElementById('navbar-drawer-close-btn');
  const iconHamb = document.getElementById('navbar-icon-hamburger');
  const iconClose = document.getElementById('navbar-icon-close');
  const header = document.getElementById('site-header');

  const openMobileMenu = () => {
    if (!navBtn || !navDrawer) return;
    navBtn.setAttribute('aria-expanded', 'true');
    navBtn.setAttribute('aria-label', 'Close menu');
    navDrawer.classList.remove('hidden');
    iconHamb?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    // Lock background scroll on document and body
    document.documentElement.classList.add('overflow-hidden');
    document.body.classList.add('overflow-hidden');
  };

  const closeMobileMenu = () => {
    if (!navBtn || !navDrawer) return;
    navBtn.setAttribute('aria-expanded', 'false');
    navBtn.setAttribute('aria-label', 'Open menu');
    navDrawer.classList.add('hidden');
    iconHamb?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
    // Restore background scroll
    document.documentElement.classList.remove('overflow-hidden');
    document.body.classList.remove('overflow-hidden');
    // Ensure header is visible when menu closes
    header?.classList.remove('-translate-y-full');
  };

  if (drawerCloseBtn) {
    drawerCloseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeMobileMenu();
    });
  }

  if (navBtn && navDrawer) {
    navBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = navBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    // Close menu when clicking any nav link
    navDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMobileMenu();
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navBtn.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
        navBtn.focus();
      }
    });

    // Auto-close on resize to desktop breakpoint (>= 768px)
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && navBtn.getAttribute('aria-expanded') === 'true') {
        closeMobileMenu();
      }
    });
  }

  // Smart Autohide on Scroll
  let lastScrollY = window.scrollY;
  let isTicking = false;
  let suppressAutohide = !!window.location.hash;

  if (suppressAutohide) {
    header?.classList.remove('-translate-y-full');
    setTimeout(() => {
      suppressAutohide = false;
      lastScrollY = window.scrollY;
    }, 1200);
  }

  window.addEventListener('hashchange', () => {
    suppressAutohide = true;
    header?.classList.remove('-translate-y-full');
    setTimeout(() => {
      suppressAutohide = false;
      lastScrollY = window.scrollY;
    }, 1000);
  });

  const handleScroll = () => {
    const currentScrollY = window.scrollY;

    // Never hide header when mobile menu is open or during initial hash alignment
    const isMobileMenuOpen = navBtn && navBtn.getAttribute('aria-expanded') === 'true';
    if (isMobileMenuOpen || suppressAutohide) {
      header?.classList.remove('-translate-y-full');
      lastScrollY = currentScrollY;
      isTicking = false;
      return;
    }

    const isHome = window.location.pathname === '/' || window.location.pathname === '';
    // On the homepage, keep header pinned while scrolling past the sticky hero
    const hideThreshold = isHome ? (window.innerHeight - 80) : 70;

    // Always reveal at top of page (threshold 20px)
    if (currentScrollY <= 20) {
      header?.classList.remove('-translate-y-full');
    } else if (currentScrollY > lastScrollY && currentScrollY > hideThreshold) {
      // Scrolling down -> hide header
      header?.classList.add('-translate-y-full');
    } else if (currentScrollY < lastScrollY) {
      // Scrolling up -> reveal header
      header?.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY;
    isTicking = false;
  };

  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(handleScroll);
      isTicking = true;
    }
  }, { passive: true });
</script>
