---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Services', href: '/services' },
  { label: 'Brands', href: '/brands' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<header id="site-header" class="sticky top-0 z-50 bg-creme-powder/90 backdrop-blur-md transition-transform duration-300 ease-in-out">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 h-14 sm:h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="inline-flex items-center focus:outline-none" aria-label="TMB Branding">
      <span class="font-sans text-[11px] uppercase tracking-luxury font-medium text-espresso">
        TMB BRANDING
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-9 lg:space-x-11" aria-label="Navigation Principale">
      {navItems.map((item) => {
        const active = isActive(item.href);
        return (
          <a
            href={item.href}
            class={`text-[11px] uppercase tracking-luxury font-medium transition-all duration-300 relative py-1.5 ${
              active
                ? 'text-terracotta-dark font-semibold'
                : 'text-taupe hover:text-espresso'
            }`}
          >
            {item.label}
            {active && (
              <span class="absolute bottom-0 left-0 right-[0.35em] h-[1.5px] bg-terracotta"></span>
            )}
          </a>
        );
      })}
    </nav>


    <!-- Mobile Menu Trigger -->
    <button
      id="navbar-toggle-btn"
      type="button"
      class="md:hidden p-2 text-espresso hover:text-terracotta focus:outline-none"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6 stroke-current" fill="none" viewBox="0 0 24 24">
        <path id="navbar-icon-hamburger" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        <path id="navbar-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Fullscreen / Drawer Lookbook Mobile Menu -->
  <div
    id="navbar-mobile-drawer"
    class="hidden md:hidden fixed inset-x-0 top-[56px] sm:top-[64px] bottom-0 bg-creme-powder/98 backdrop-blur-xl border-t border-creme-border px-8 py-12 flex flex-col justify-between overflow-y-auto"
  >
    <div class="space-y-6 pt-4">
      <p class="text-[10px] uppercase tracking-kicker text-ocre font-sans font-semibold">
        Navigation Studio
      </p>
      <nav class="flex flex-col space-y-4">
        {navItems.map((item, idx) => (
          <a
            href={item.href}
            class={`font-serif text-3xl sm:text-4xl transition-colors duration-300 flex items-baseline justify-between border-b border-creme-border/50 pb-3 ${
              isActive(item.href)
                ? 'text-terracotta italic font-normal'
                : 'text-espresso hover:text-terracotta'
            }`}
          >
            <span>{item.label}</span>
            <span class="font-sans text-[10px] tracking-widest text-taupe-muted uppercase">
              0{idx + 1}
            </span>
          </a>
        ))}
      </nav>
    </div>

    <div class="pt-8 pb-6 border-t border-creme-border/70 space-y-4">
      <div class="text-xs text-taupe space-y-1">
        <p class="font-serif text-base text-espresso">TMB Branding &mdash; Austin, TX</p>
        <p>Available for commissions worldwide &bull; +1 512 529 1677</p>
      </div>
      <a
        href="/contact"
        class="block w-full text-center py-4 text-xs uppercase tracking-luxury font-medium text-creme bg-espresso hover:bg-terracotta shadow-warm transition-colors"
      >
        Start a Project &rarr;
      </a>
    </div>
  </div>
</header>

<script is:inline>
  const navBtn = document.getElementById('navbar-toggle-btn');
  const navDrawer = document.getElementById('navbar-mobile-drawer');
  const iconHamb = document.getElementById('navbar-icon-hamburger');
  const iconClose = document.getElementById('navbar-icon-close');
  const header = document.getElementById('site-header');

  if (navBtn && navDrawer) {
    navBtn.addEventListener('click', () => {
      const isExpanded = navBtn.getAttribute('aria-expanded') === 'true';
      navBtn.setAttribute('aria-expanded', String(!isExpanded));
      navDrawer.classList.toggle('hidden');
      if (iconHamb && iconClose) {
        iconHamb.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      }
      // Lock background scroll when drawer is open
      if (!isExpanded) {
        document.body.style.overflow = 'hidden';
      } else {
        document.body.style.overflow = '';
      }
    });

    // Close menu when clicking any nav link
    navDrawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navDrawer.classList.add('hidden');
        navBtn.setAttribute('aria-expanded', 'false');
        if (iconHamb && iconClose) {
          iconHamb.classList.remove('hidden');
          iconClose.classList.add('hidden');
        }
        document.body.style.overflow = '';
      });
    });
  }

  // Smart Autohide on Scroll
  let lastScrollY = window.scrollY;
  let isTicking = false;

  const handleScroll = () => {
    const currentScrollY = window.scrollY;

    // Do not hide if mobile drawer menu is open
    const isMobileMenuOpen = navBtn && navBtn.getAttribute('aria-expanded') === 'true';
    if (isMobileMenuOpen) {
      header?.classList.remove('-translate-y-full');
      lastScrollY = currentScrollY;
      isTicking = false;
      return;
    }

    // Always reveal at top of page (threshold 20px)
    if (currentScrollY <= 20) {
      header?.classList.remove('-translate-y-full');
    } else if (currentScrollY > lastScrollY && currentScrollY > 70) {
      // Scrolling down -> hide header
      header?.classList.add('-translate-y-full');
    } else if (currentScrollY < lastScrollY) {
      // Scrolling up -> reveal header
      header?.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY;
    isTicking = false;
  };

  window.addEventListener('scroll', () => {
    if (!isTicking) {
      window.requestAnimationFrame(handleScroll);
      isTicking = true;
    }
  }, { passive: true });
</script>
