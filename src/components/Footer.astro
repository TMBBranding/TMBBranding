---
const currentYear = new Date().getFullYear();
---

<footer class="bg-espresso text-creme-powder mt-auto border-t border-espresso-light">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-20">
    <!-- Main Unified Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 pb-12 border-b border-espresso-light/60">
      
      <!-- Direct Contact & Inquiries -->
      <div class="md:col-span-8 space-y-4">
        <h3 class="text-xs uppercase tracking-luxury text-ocre font-sans font-semibold">
          Initiate a Project
        </h3>
        <p class="text-xs sm:text-sm text-taupe-light leading-relaxed font-light max-w-xl">
          Whether you're launching something new or evolving an established brand, our doors in Austin and worldwide are open.
        </p>
        <div class="flex flex-wrap items-center gap-y-2 gap-x-8 pt-2">
          <a
            href="/contact"
            class="text-creme-powder hover:text-terracotta transition-colors underline underline-offset-4 decoration-espresso-light text-base font-serif"
          >
            Contact us
          </a>
          <a
            href="tel:+15125291677"
            class="text-taupe-light hover:text-creme font-sans text-xs transition-colors"
          >
            +1 512 529 1677
          </a>
          <a
            href="mailto:tiffany@tmbbranding.com"
            class="text-taupe-light hover:text-creme font-sans text-xs transition-colors"
          >
            tiffany@tmbbranding.com
          </a>
        </div>
      </div>

      <!-- Follow Us Section -->
      <div class="md:col-span-4 space-y-4 md:text-right flex flex-col md:items-end justify-start">
        <h3 class="text-xs uppercase tracking-luxury text-ocre font-sans font-semibold">
          Follow Us
        </h3>
        <p class="text-xs text-taupe-light font-light">
          Stories & founder perspectives
        </p>
        <div class="pt-1">
          <a
            href="https://www.instagram.com/tmbbranding/"
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center space-x-2 text-white hover:text-terracotta transition-colors duration-200"
            aria-label="Follow TMB Branding on Instagram"
            title="Instagram @tmbbranding"
          >
            <svg
              class="w-5 h-5 text-white group-hover:text-terracotta transition-colors duration-200"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs uppercase tracking-luxury font-medium text-white group-hover:text-terracotta transition-colors">
              @tmbbranding
            </span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Credits & Legal -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-taupe space-y-4 sm:space-y-0">
      <p>
        &copy; {currentYear} TMB Branding. All rights reserved. Austin, Texas.
      </p>
      <div class="flex items-center space-x-6 text-[10px] tracking-widest uppercase text-taupe-light">
        <span>Headquarters: Austin, TX</span>
        <span>&bull;</span>
        <span>Worldwide</span>
      </div>
    </div>
  </div>
</footer>
