---
import { getEntry } from 'astro:content';

const settingsEntry = await getEntry('pages', 'settings');
const settings = settingsEntry?.data;

const currentYear = new Date().getFullYear();
const phone = settings?.phone || "+1 512 529 1677";
const email = settings?.email || "tiffany@tmbbranding.com";
const instagramHandle = settings?.instagramHandle || "@tmbbranding";
const instagramUrl = settings?.instagramUrl || "https://www.instagram.com/tmbbranding/";
const inquiriesTitle = settings?.inquiriesTitle || "WORK WITH TMB";
const contactLinkText = settings?.contactLinkText || "Contact us";
const socialTitle = settings?.socialTitle || "Follow Us";
const location = settings?.location || "Austin, Texas";
const copyrightText = settings?.copyrightText || `© ${currentYear} TMB Branding. All rights reserved.`;
---

<footer class="bg-creme-powder text-espresso mt-auto border-t border-creme-border/60">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-20">
    <!-- Main Unified Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-16 pb-12 border-b border-creme-border/60">
      
      <!-- Direct Contact & Inquiries -->
      <div class="md:col-span-8 space-y-4">
        <h3 class="text-xs uppercase tracking-luxury text-taupe font-sans font-semibold">
          {inquiriesTitle}
        </h3>
        <div class="flex flex-wrap items-center gap-y-2 gap-x-8 pt-1">
          <a
            href="/contact"
            class="text-taupe hover:text-espresso font-sans text-sm transition-colors"
          >
            {contactLinkText}
          </a>
          <a
            href={`tel:${phone.replace(/\s+/g, '')}`}
            class="text-taupe hover:text-espresso font-sans text-sm transition-colors"
          >
            {phone}
          </a>
          <a
            href={`mailto:${email}`}
            class="text-taupe hover:text-espresso font-sans text-sm transition-colors"
          >
            {email}
          </a>
        </div>
      </div>

      <!-- Follow Us Section -->
      <div class="md:col-span-4 space-y-4 md:text-right flex flex-col md:items-end justify-start">
        <h3 class="text-xs uppercase tracking-luxury text-taupe font-sans font-semibold">
          {socialTitle}
        </h3>
        <div class="pt-1">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center space-x-2 text-taupe hover:text-espresso transition-colors duration-200"
            aria-label={`Follow TMB Branding on Instagram ${instagramHandle}`}
            title={`Instagram ${instagramHandle}`}
          >
            <svg
              class="w-5 h-5 text-taupe group-hover:text-espresso transition-colors duration-200"
              fill="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
            </svg>
            <span class="text-xs uppercase tracking-luxury font-medium text-taupe group-hover:text-espresso transition-colors">
              {instagramHandle}
            </span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Credits & Legal -->
    <div class="pt-8 text-center text-xs text-taupe">
      <p>
        {copyrightText}
      </p>
    </div>
  </div>
</footer>
