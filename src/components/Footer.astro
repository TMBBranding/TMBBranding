---
const currentYear = new Date().getFullYear();
---

<footer class="bg-espresso text-creme-powder mt-auto border-t border-espresso-light">
  <!-- Top Marquee or Baseline Banner -->
  <div class="border-b border-espresso-light/60 py-6 px-6 sm:px-8 lg:px-12 bg-espresso-deep/60">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between text-xs tracking-editorial uppercase text-taupe-light space-y-2 sm:space-y-0">
      <span class="flex items-center space-x-2">
        <span class="w-2 h-2 rounded-full bg-terracotta inline-block"></span>
        <span class="text-creme">TMB BRANDING &bull; AUSTIN, TEXAS</span>
      </span>
      <span class="text-[11px] font-serif italic text-ocre lowercase">
        "bringing visionary ideas to life through strategic storytelling"
      </span>
      <span class="text-taupe-muted">GLOBAL ENGAGEMENTS</span>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 pt-20 pb-12">
    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 pb-16 border-b border-espresso-light/60">
      
      <!-- Studio Identity & Mission -->
      <div class="md:col-span-5 space-y-6">
        <a href="/" class="inline-block focus:outline-none group">
          <span class="font-serif text-3xl sm:text-4xl tracking-editorial text-creme-powder font-normal group-hover:text-terracotta transition-colors duration-300">
            TMB BRANDING
          </span>
          <span class="block text-[10px] uppercase tracking-kicker text-ocre font-sans font-medium mt-1">
            Elevating Founder-Led Brands
          </span>
        </a>
        <p class="text-taupe-light text-sm leading-relaxed max-w-sm font-light">
          A bespoke brand building and digital marketing studio founded by Tiffany in Austin, TX. We craft thoughtful campaigns and experiences that spark connection and drive growth.
        </p>
        <div class="pt-2 text-xs text-taupe font-sans">
          <span>Headquarters: Austin, TX</span>
          <span class="mx-2">&bull;</span>
          <span>Fashion &bull; Beauty &bull; Lifestyle</span>
        </div>
      </div>

      <!-- Quick Directory -->
      <div class="md:col-span-3 space-y-4">
        <h3 class="text-xs uppercase tracking-luxury text-ocre font-sans font-semibold">
          Pages
        </h3>
        <ul class="space-y-3 text-xs tracking-editorial uppercase">
          <li>
            <a href="/" class="text-creme-linen hover:text-terracotta transition-colors duration-200">
              01. Accueil
            </a>
          </li>
          <li>
            <a href="/services" class="text-creme-linen hover:text-terracotta transition-colors duration-200">
              02. Services
            </a>
          </li>
          <li>
            <a href="/brands" class="text-creme-linen hover:text-terracotta transition-colors duration-200">
              03. Brands (Portfolio)
            </a>
          </li>
          <li>
            <a href="/about" class="text-creme-linen hover:text-terracotta transition-colors duration-200">
              04. About Us
            </a>
          </li>
          <li>
            <a href="/contact" class="text-creme-linen hover:text-terracotta transition-colors duration-200">
              05. Contact
            </a>
          </li>
        </ul>
      </div>

      <!-- Direct Contact & Inquiries -->
      <div class="md:col-span-4 space-y-4">
        <h3 class="text-xs uppercase tracking-luxury text-ocre font-sans font-semibold">
          Initiate a Project
        </h3>
        <p class="text-xs text-taupe-light leading-relaxed font-light">
          Whether you're launching something new or evolving an established brand, our doors in Austin and worldwide are open.
        </p>
        <div class="space-y-2 pt-2 text-sm font-serif">
          <div>
            <a
              href="/contact"
              class="text-creme-powder hover:text-terracotta transition-colors underline underline-offset-4 decoration-espresso-light text-base inline-flex items-center"
            >
              <span>Initiate Private Dialogue</span>
              <span class="ml-1.5 font-sans text-xs">&rarr;</span>
            </a>
          </div>
          <div>
            <a href="tel:+15125291677" class="text-taupe-light hover:text-creme font-sans text-xs">
              +1 512 529 1677
            </a>
          </div>
        </div>
        <div class="pt-4">
          <a
            href="/admin/"
            class="inline-flex items-center text-[10px] uppercase tracking-widest text-taupe hover:text-ocre transition-colors"
            title="Accès à l'administration Decap CMS"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-ocre mr-2 inline-block"></span>
            Decap CMS Portal &rarr;
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Credits & Legal -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-taupe space-y-4 sm:space-y-0">
      <p>
        &copy; {currentYear} TMB Branding. All rights reserved. Austin, Texas.
      </p>
      <div class="flex items-center space-x-6 text-[10px] tracking-widest uppercase text-taupe-light">
        <a href="/about" class="hover:text-terracotta transition-colors">About Tiffany</a>
        <span>&bull;</span>
        <a href="/brands" class="hover:text-terracotta transition-colors">Selected Brands</a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-terracotta transition-colors">Start a Project</a>
      </div>
    </div>
  </div>
</footer>
