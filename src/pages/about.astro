---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import type { AboutPageData } from '../content/config';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error("Impossible de charger la collection 'pages/about'");
}
const about = aboutEntry.data as AboutPageData;

function renderMarkdownLinks(text?: string) {
  if (!text) return '';
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" class="text-espresso font-medium underline underline-offset-4 decoration-black hover:text-terracotta hover:decoration-black transition-colors">$1</a>'
  );
}
---

<Layout
  title={about.seo.metaTitle}
  description={about.seo.metaDescription}
  ogImage={about.seo.ogImage}
  currentPath="/about"
>
  <!-- 1. HERO HEADER -->
  <section class="pt-16 pb-8 sm:pt-20 sm:pb-10 lg:pt-24 lg:pb-12">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {about.hero.title}
        </h1>
      </div>
    </div>
  </section>

  <!-- 2. BIO FOUNDER SECTION (TIFFANY) -->
  <section class="pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Portrait Column with Studio Framing -->
        <div class="lg:col-span-5">
          <div class="relative">
            <!-- Warm Ambient Shadow -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-ocre-soft/50 via-terracotta-soft/30 to-transparent blur-lg opacity-60"></div>

            <div class="relative aspect-[3/4] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={about.bioFounder.portraitImage}
                alt={`Portrait of ${about.bioFounder.name}`}
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Biography Story Column -->
        <div class="lg:col-span-7 space-y-8 lg:pl-4">
          {about.hero.subtitle && (
            <div class="space-y-3">
              <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-editorial">
                {about.hero.subtitle}
              </h2>
            </div>
          )}

          <!-- Paragraphs from bioFounder.body -->
          <div class="space-y-6 text-taupe text-base sm:text-lg font-light leading-relaxed whitespace-pre-line">
            {about.bioFounder.body}
          </div>

          <!-- Closing Invitation with Links from Decap CMS -->
          {about.closingText && (
            <p
              class="text-taupe text-base sm:text-lg font-light leading-relaxed"
              set:html={renderMarkdownLinks(about.closingText)}
            />
          )}
        </div>

      </div>
    </div>
  </section>
</Layout>
