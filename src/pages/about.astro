---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getEntry, render } from 'astro:content';
import type { AboutPageData } from '../content/config';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error("Impossible de charger la collection 'pages/about'");
}
const about = aboutEntry.data as AboutPageData;
const { Content: AboutContent } = await render(aboutEntry);
---

<Layout
  title={about.seo.metaTitle}
  description={about.seo.metaDescription}
  ogImage={about.seo.ogImage}
  currentPath="/about"
>
  <!-- 1. HERO HEADER -->
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24 border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center space-x-3.5">
          <span class="w-8 h-[1px] bg-ocre"></span>
          <span class="text-[11px] uppercase tracking-kicker text-ocre font-sans font-semibold">
            About the Atelier
          </span>
        </div>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {about.hero.title}
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          {about.hero.subtitle}
        </p>
      </div>

      <!-- Studio Cover Banner -->
      <div class="mt-12 sm:mt-16 relative aspect-[16/9] sm:aspect-[21/9] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm">
        <img
          src={about.hero.coverImage}
          alt="TMB Branding Studio — Austin TX"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. STATS / HIGHLIGHTS RIBBON -->
  <section class="py-16 sm:py-20 bg-creme-alabaster border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 text-center">
        {about.statsOrHighlights.map((stat) => (
          <div class="space-y-2 p-2">
            <span class="font-serif text-4xl sm:text-5xl lg:text-6xl text-espresso font-normal block">
              {stat.figure}
            </span>
            <span class="text-xs uppercase tracking-luxury text-taupe font-sans block max-w-[200px] mx-auto font-medium">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. BIO FOUNDER SECTION (TIFFANY) -->
  <section class="py-24 sm:py-32 border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Portrait Column with Studio Framing -->
        <div class="lg:col-span-5 space-y-4">
          <div class="relative group">
            <!-- Warm Ambient Shadow -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-ocre-soft/50 via-terracotta-soft/30 to-transparent blur-lg opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>

            <div class="relative aspect-[3/4] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={about.bioFounder.portraitImage}
                alt={`Portrait of ${about.bioFounder.name}`}
                class="w-full h-full object-cover object-top slow-zoom"
                loading="lazy"
              />
            </div>
          </div>

          <!-- Caption Plate -->
          <div class="p-5 bg-creme-alabaster border border-creme-border flex items-center justify-between">
            <div>
              <h3 class="font-serif text-xl text-espresso font-medium">
                {about.bioFounder.name}
              </h3>
              <p class="text-[10px] uppercase tracking-luxury text-terracotta font-sans font-semibold">
                {about.bioFounder.role}
              </p>
            </div>
            <span class="text-[10px] uppercase tracking-widest text-taupe font-sans">
              Austin, TX
            </span>
          </div>
        </div>

        <!-- Biography Story Column -->
        <div class="lg:col-span-7 space-y-8 lg:pl-4">
          <div class="space-y-3">
            <span class="text-[10px] uppercase tracking-kicker text-terracotta font-sans font-semibold block">
              Founder Profile &amp; Vision
            </span>
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-editorial">
              The founder-led story behind a founder-led agency.
            </h2>
          </div>

          <!-- Paragraphs from bioFounder.body -->
          <div class="space-y-6 text-taupe text-base sm:text-lg font-light leading-relaxed whitespace-pre-line">
            {about.bioFounder.body}
          </div>

          <!-- Markdown Content from Body (Team Philosophy) -->
          <div class="prose prose-stone text-taupe text-base sm:text-lg font-light leading-relaxed border-l-2 border-ocre pl-6 italic bg-creme-alabaster/60 p-5">
            <AboutContent />
          </div>

          <div class="pt-2">
            <Button href="/contact" variant="primary" size="md">
              Start a Conversation with Tiffany
            </Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 4. AGENCY CORE VALUES IN SOFT TERRACOTTA BLOCKS -->
  <section class="py-24 sm:py-32 bg-creme-alabaster border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-2xl mb-16 space-y-2">
        <span class="text-[10px] uppercase tracking-kicker text-ocre font-sans font-semibold block">
          Guiding Ethos
        </span>
        <h2 class="font-serif text-4xl sm:text-5xl text-espresso">
          What Makes TMB Different
        </h2>
        <p class="text-taupe text-sm sm:text-base font-light">
          We layer strategic storytelling with visual identity to build brands that grow in depth, not just numbers.
        </p>
      </div>

      <!-- Values in Soft Terracotta / Ocre Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {about.values.map((val, idx) => (
          <div class="bg-creme-powder p-8 sm:p-10 border border-terracotta/25 hover:border-terracotta shadow-warm-xs hover:shadow-warm transition-all duration-400 space-y-4 relative overflow-hidden group">
            <!-- Subtle Terracotta Accent Accent Top Bar -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-terracotta via-ocre to-terracotta-light opacity-80 group-hover:opacity-100 transition-opacity"></div>

            <span class="font-mono text-xs text-terracotta block">
              PILLAR 0{idx + 1}
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl text-espresso group-hover:text-terracotta transition-colors duration-300">
              {val.title}
            </h3>
            <p class="text-taupe text-sm sm:text-base leading-relaxed font-light">
              {val.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. INITIATE DIALOGUE CTA -->
  <section class="py-20 sm:py-28 bg-espresso text-creme-powder text-center">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 lg:px-12 space-y-6">
      <span class="text-[10px] uppercase tracking-kicker text-ocre font-sans font-semibold block">
        Start a Project
      </span>
      <h2 class="font-serif text-4xl sm:text-5xl text-creme font-normal leading-tight">
        Interested in starting a project?
      </h2>
      <p class="text-taupe-light text-base sm:text-lg font-light leading-relaxed max-w-xl mx-auto">
        Contact us for more information on how we can work hand-in-hand as an extension of your team.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Contact Us for More Information
        </Button>
      </div>
    </div>
  </section>
</Layout>
