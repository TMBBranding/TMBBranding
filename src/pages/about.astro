---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import type { AboutPageData } from '../content/config';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error("Impossible de charger la collection 'pages/about'");
}
const about = aboutEntry.data as AboutPageData;
---

<Layout
  title={about.seo.metaTitle}
  description={about.seo.metaDescription}
  ogImage={about.seo.ogImage}
  currentPath="/about"
>
  <!-- 1. HERO HEADER -->
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24 border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {about.hero.title}
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          {about.hero.subtitle}
        </p>
      </div>

      <!-- Studio Cover Banner -->
      <div class="mt-12 sm:mt-16 relative aspect-[16/9] sm:aspect-[21/9] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm">
        <img
          src={about.hero.coverImage}
          alt="TMB Branding Studio — Austin TX"
          class="w-full h-full object-cover object-center"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- 2. BIO FOUNDER SECTION (TIFFANY) -->
  <section class="py-24 sm:py-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Portrait Column with Studio Framing -->
        <div class="lg:col-span-5">
          <div class="relative group">
            <!-- Warm Ambient Shadow -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-ocre-soft/50 via-terracotta-soft/30 to-transparent blur-lg opacity-60 group-hover:opacity-100 transition-opacity duration-700"></div>

            <div class="relative aspect-[3/4] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={about.bioFounder.portraitImage}
                alt={`Portrait of ${about.bioFounder.name}`}
                class="w-full h-full object-cover object-top slow-zoom"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Biography Story Column -->
        <div class="lg:col-span-7 space-y-8 lg:pl-4">
          <div class="space-y-3">
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-editorial">
              The founder-led story behind a founder-led agency.
            </h2>
          </div>

          <!-- Paragraphs from bioFounder.body -->
          <div class="space-y-6 text-taupe text-base sm:text-lg font-light leading-relaxed whitespace-pre-line">
            {about.bioFounder.body}
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>
