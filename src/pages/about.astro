---
import Layout from '../layouts/Layout.astro';
import AnimatedTMB from '../components/AnimatedTMB.astro';
import { getEntry } from 'astro:content';
import type { AboutPageData } from '../content/config';

const aboutEntry = await getEntry('pages', 'about');
if (!aboutEntry) {
  throw new Error("Failed to load collection 'pages/about'");
}
const about = aboutEntry.data as AboutPageData;
const animateTitle = about.hero.animateTitle ?? true;

function renderMarkdownLinks(text?: string) {
  if (!text) return '';
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" class="text-espresso font-medium underline underline-offset-4 decoration-espresso/35 hover:decoration-black transition-colors duration-200">$1</a>'
  );
}

// Split the body into paragraphs.
// Supports:
// 1. Explicit <!-- split --> delimiter in the markdown
// 2. Or configured paragraphsBesidePhoto number in Decap CMS
// 3. Or automatic fallback (legacy phrase or 3 paragraphs)
const rawBody = about.bioFounder.body || '';
let topParagraphs: string[] = [];
let bottomParagraphs: string[] = [];

if (rawBody.includes('<!-- split -->')) {
  const [topPart, ...bottomParts] = rawBody.split('<!-- split -->');
  topParagraphs = topPart.split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
  bottomParagraphs = bottomParts.join('\n\n').split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
} else {
  const allParagraphs = rawBody
    .split(/\n\s*\n/)
    .map((p) => p.trim())
    .filter(Boolean);

  const legacyIndex = allParagraphs.findIndex((p) =>
    p.toLowerCase().includes('then a transition')
  );

  const splitIndex = typeof about.paragraphsBesidePhoto === 'number'
    ? about.paragraphsBesidePhoto
    : (legacyIndex > 0 ? legacyIndex : 3);

  topParagraphs = allParagraphs.slice(0, splitIndex);
  bottomParagraphs = allParagraphs.slice(splitIndex);
}
---

<Layout
  title={about.seo.metaTitle}
  description={about.seo.metaDescription}
  ogImage={about.seo.ogImage}
  currentPath="/about"
>
  <!-- 1. HERO HEADER -->
  <section class="pt-16 pb-8 sm:pt-20 sm:pb-10 lg:pt-24 lg:pb-12">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {animateTitle ? (
            (() => {
              const rawTitle = (about.hero.title || "Building TMB").trim();
              
              // Check for explicit asterisks like "Building *TMB*"
              const asteriskMatch = rawTitle.match(/^(.*?)\*(.*?)\*(.*)$/);
              if (asteriskMatch) {
                const [, before, tmbPart, after] = asteriskMatch;
                return (
                  <>
                    {before.trimEnd()}
                    <span class="inline-block ml-3 sm:ml-4 lg:ml-5">
                      {tmbPart.trim().toUpperCase() === 'TMB' ? (
                        <AnimatedTMB class="text-espresso fill-espresso" />
                      ) : (
                        <span class="font-sans font-extralight tracking-normal text-[0.88em] inline-block align-baseline">{tmbPart}</span>
                      )}
                    </span>
                    {after}
                  </>
                );
              }
              
              // Or automatically detect "TMB"
              if (rawTitle.includes('TMB')) {
                const parts = rawTitle.split('TMB');
                const before = parts[0];
                const after = parts.slice(1).join('TMB');
                return (
                  <>
                    {before.trimEnd()}
                    <span class="inline-block ml-3 sm:ml-4 lg:ml-5">
                      <AnimatedTMB class="text-espresso fill-espresso" />
                    </span>
                    {after}
                  </>
                );
              }
              
              return rawTitle;
            })()
          ) : (
            about.hero.title || "Building TMB"
          )}
        </h1>
      </div>
    </div>
  </section>

  <!-- 2. BIO FOUNDER SECTION (TIFFANY) -->
  <section class="pb-24 sm:pb-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start lg:items-center">
        
        <!-- Portrait Column with Studio Framing -->
        <div class="lg:col-span-5 lg:self-center">
          <div class="relative">
            <!-- Warm Ambient Shadow -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-creme-border/50 via-taupe/10 to-transparent blur-lg opacity-60"></div>

            <div class="relative aspect-[3/4] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={about.bioFounder.portraitImage}
                alt={about.bioFounder.portraitAlt || `Portrait of ${about.bioFounder.name}`}
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Biography Story Column (Top Story) -->
        <div class="lg:col-span-7 space-y-6 lg:pl-4">
          {about.hero.subtitle && (
            <div class="space-y-3">
              <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-editorial">
                {about.hero.subtitle}
              </h2>
            </div>
          )}

          <!-- Paragraphs beside the photo -->
          <div class="space-y-6 text-taupe text-base sm:text-lg font-light leading-relaxed">
            {topParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>

      </div>

      <!-- Bottom Full-Width Story: Starts with "Then a transition into beauty" under the photo -->
      {bottomParagraphs.length > 0 && (
        <div class="mt-4 sm:mt-6 lg:mt-6 space-y-6 sm:space-y-8 text-taupe text-base sm:text-lg font-light leading-relaxed">
          {bottomParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}

          <!-- Closing Invitation with Links from Decap CMS -->
          {about.closingText && (
            <div class="pt-4 sm:pt-6">
              <p
                class="text-taupe text-base sm:text-lg font-light leading-relaxed"
                set:html={renderMarkdownLinks(about.closingText)}
              />
            </div>
          )}
        </div>
      )}
    </div>
  </section>
</Layout>
