---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getCollection, render } from 'astro:content';

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Pre-render case studies for each brand
const renderedBrands = await Promise.all(
  brands.map(async (brand) => {
    const { Content } = await render(brand);
    return {
      brand,
      Content,
    };
  })
);
---

<Layout
  title="Our Brands & Case Studies — TMB Branding | Austin, TX"
  description="Explore our portfolio of founder-led fashion, beauty, wellness, and lifestyle brands, including Surya by Martha Soffer, N2B4B, Influxious, Recess, L'Une, and OPI."
  currentPath="/brands"
>
  <!-- HEADER SECTION -->
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24 border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <div class="inline-flex items-center space-x-3.5">
          <span class="w-8 h-[1px] bg-ocre"></span>
          <span class="text-[11px] uppercase tracking-kicker text-ocre font-sans font-semibold">
            Portfolio &amp; Partnerships
          </span>
        </div>
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          Our Brands
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          We’re proud to partner with some of the most inspiring founder-led brands in the fashion, beauty, wellness, and lifestyle spaces. From seed-stage to household names, our work is rooted in strategy, storytelling, and a deep belief in what each brand stands for.
        </p>
      </div>
    </div>
  </section>

  <!-- MAGAZINE-STYLE BRANDS GALLERY -->
  <section class="py-20 sm:py-28 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 space-y-28 sm:space-y-36">
      {renderedBrands.map(({ brand, Content }, index) => {
        const isReversed = index % 2 === 1;
        return (
          <article class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center pb-24 sm:pb-32 border-b border-creme-border/60 last:border-b-0 last:pb-0">
            <!-- Imagery & Logo Container -->
            <div class={`lg:col-span-7 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
              <div class="space-y-4">
                <div class="relative group">
                  <div class="relative aspect-[16/10] overflow-hidden rounded-luxury-lg bg-creme-alabaster border border-creme-border shadow-warm group-hover:shadow-warm-lg transition-shadow duration-500">
                    <img
                      src={brand.data.coverImage}
                      alt={brand.data.name}
                      class="w-full h-full object-cover object-center slow-zoom"
                      loading="lazy"
                    />
                    <!-- Industry Badge -->
                    <div class="absolute top-4 left-4 bg-creme-powder/95 backdrop-blur-md px-3.5 py-1 rounded-luxury-sm text-[10px] uppercase tracking-widest text-espresso font-medium border border-creme-border/70 shadow-warm-xs">
                      {brand.data.industry}
                    </div>
                  </div>
                </div>

                <!-- Client Logo & Website Card -->
                <div class="bg-creme-alabaster/90 border border-creme-border rounded-luxury p-5 flex items-center justify-between">
                  <div class="h-9 max-w-[190px] flex items-center">
                    <img
                      src={brand.data.logoImage}
                      alt={`${brand.data.name} logo`}
                      class="max-h-full w-auto object-contain opacity-85 hover:opacity-100 transition-opacity"
                      loading="lazy"
                    />
                  </div>
                  {brand.data.websiteUrl && (
                    <a
                      href={brand.data.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[10px] uppercase tracking-luxury text-taupe hover:text-terracotta font-sans font-medium inline-flex items-center group/link"
                    >
                      <span>Explore Flagship</span>
                      <span class="ml-1.5 transform group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5 transition-transform">&nearr;</span>
                    </a>
                  )}
                </div>
              </div>
            </div>

            <!-- Case Study / Editorial Copy Column -->
            <div class={`lg:col-span-5 space-y-6 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
              <div class="space-y-2">
                <span class="text-[10px] font-mono text-terracotta uppercase tracking-luxury font-medium block">
                  Case Study 0{brand.data.order}
                </span>
                <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-tight">
                  {brand.data.name}
                </h2>
              </div>

              <!-- Deliverable Tags -->
              <div class="flex flex-wrap gap-2 pt-1">
                {brand.data.deliverableTags.map((tag) => (
                  <span class="text-[10px] uppercase tracking-wider text-espresso bg-creme-alabaster px-3 py-1 rounded-luxury-sm font-medium border border-creme-border/80">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Synopsis Quote Box -->
              {brand.data.caseStudyBody && (
                <p class="text-sm sm:text-base text-espresso/90 leading-relaxed font-light bg-creme-alabaster p-5 rounded-luxury border-l-2 border-ocre italic">
                  "{brand.data.caseStudyBody}"
                </p>
              )}

              <!-- Rendered Markdown Details -->
              <div class="prose prose-stone text-taupe text-sm leading-relaxed font-light prose-headings:font-serif prose-headings:text-espresso prose-headings:font-normal prose-h3:text-lg prose-h3:mt-4 prose-h3:mb-2 prose-ul:my-2 prose-li:my-1 prose-li:marker:text-terracotta prose-strong:text-espresso prose-strong:font-medium">
                <Content />
              </div>

              <div class="pt-2">
                <Button href="/contact" variant="tertiary">
                  Discuss a Similar Project &rarr;
                </Button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- BOTTOM INVITATION CTA -->
  <section class="py-20 sm:py-28 bg-espresso text-creme-powder text-center">
    <div class="max-w-3xl mx-auto px-6 sm:px-8 lg:px-12 space-y-6">
      <span class="text-[10px] uppercase tracking-kicker text-ocre font-sans font-semibold block">
        Start a Project
      </span>
      <h2 class="font-serif text-4xl sm:text-5xl text-creme font-normal leading-tight">
        Interested in starting a project?
      </h2>
      <p class="text-taupe-light text-base sm:text-lg font-light leading-relaxed max-w-xl mx-auto">
        Contact us for more information on how we can build momentum and community for your brand.
      </p>
      <div class="pt-4">
        <Button href="/contact" variant="primary" size="lg">
          Contact Us for More Information
        </Button>
      </div>
    </div>
  </section>
</Layout>
