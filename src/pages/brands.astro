---
import Layout from '../layouts/Layout.astro';
import AnimatedLetterO from '../components/AnimatedLetterO.astro';
import { getCollection, getEntry, render } from 'astro:content';
import type { BrandsPageData } from '../content/config';
import fs from 'node:fs';
import path from 'node:path';

function getImageDimensions(imagePath: string): { width: number; height: number } | null {
  try {
    const fullPath = path.join(process.cwd(), 'public', imagePath.replace(/^\//, ''));
    if (!fs.existsSync(fullPath)) return null;
    const buffer = fs.readFileSync(fullPath);

    // PNG
    if (buffer[0] === 0x89 && buffer[1] === 0x50 && buffer[2] === 0x4E && buffer[3] === 0x47) {
      return { width: buffer.readUInt32BE(16), height: buffer.readUInt32BE(20) };
    }

    // JPEG
    if (buffer[0] === 0xFF && buffer[1] === 0xD8) {
      let offset = 2;
      while (offset < buffer.length) {
        if (buffer[offset] !== 0xFF) break;
        const marker = buffer[offset + 1];
        if (marker === 0xC0 || marker === 0xC2) {
          return {
            height: buffer.readUInt16BE(offset + 5),
            width: buffer.readUInt16BE(offset + 7),
          };
        }
        offset += 2 + buffer.readUInt16BE(offset + 2);
      }
    }

    // WebP
    if (buffer.toString('ascii', 0, 4) === 'RIFF' && buffer.toString('ascii', 8, 12) === 'WEBP') {
      const vp8 = buffer.toString('ascii', 12, 16);
      if (vp8 === 'VP8 ') {
        return { width: buffer.readUInt16LE(26) & 0x3fff, height: buffer.readUInt16LE(28) & 0x3fff };
      }
      if (vp8 === 'VP8L') {
        const b1 = buffer[21], b2 = buffer[22], b3 = buffer[23], b4 = buffer[24];
        return { width: 1 + (((b2 & 0x3f) << 8) | b1), height: 1 + (((b4 & 0xf) << 10) | (b3 << 2) | ((b2 & 0xc0) >> 6)) };
      }
      if (vp8 === 'VP8X') {
        return { width: 1 + buffer.readUIntLE(24, 3), height: 1 + buffer.readUIntLE(27, 3) };
      }
    }
  } catch {
    return null;
  }
  return null;
}

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Pre-render case studies for each brand
const renderedBrands = await Promise.all(
  brands.map(async (brand) => {
    const { Content } = await render(brand);
    const dimensions = getImageDimensions(brand.data.coverImage);
    const isPortrait = dimensions ? dimensions.height > dimensions.width : false;
    return {
      brand,
      Content,
      dimensions,
      isPortrait,
    };
  })
);

const brandsPageEntry = await getEntry('pages', 'brands');
const brandsPage = brandsPageEntry?.data as BrandsPageData | undefined;
const animateTitle = brandsPage?.animateTitle ?? true;
---

<Layout
  title={brandsPage?.seo?.metaTitle || "Our Brands & Case Studies — TMB Branding"}
  description={brandsPage?.seo?.metaDescription || "Explore our portfolio of founder-led fashion, beauty, wellness, and lifestyle brands, including Surya by Martha Soffer, N2B4B, Influxious, Recess, L'Une, and OPI."}
  ogImage={brandsPage?.seo?.ogImage}
  currentPath="/brands"
>
  <!-- HEADER SECTION -->
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial" aria-label={brandsPage?.title || "Our Brands"}>
          {animateTitle ? (
            (() => {
              const rawTitle = brandsPage?.title || "Our Brands";
              const trimmed = rawTitle.trimStart();
              const startsWithO = /^[OoÔôÖö]/.test(trimmed);

              if (!startsWithO) {
                return rawTitle;
              }

              const restOfTitle = trimmed.slice(1);
              const baseDelay = 1.68;
              const stagger = 0.210;

              let charIndex = 0;
              const words = restOfTitle.split(/(\s+)/);

              return (
                <>
                  <span class="inline-block" aria-hidden="true"><AnimatedLetterO /></span>{words.map((chunk) => {
                    if (/^\s+$/.test(chunk)) {
                      charIndex += 0.5;
                      return <span class="char-space" aria-hidden="true">&nbsp;</span>;
                    }
                    return (
                      <span class="inline-block whitespace-nowrap" aria-hidden="true">
                        {chunk.split('').map((char) => {
                          const delay = (baseDelay + charIndex * stagger).toFixed(3);
                          charIndex++;
                          return (
                            <span
                              class="mist-char"
                              style={`animation-delay: ${delay}s;`}
                              aria-hidden="true"
                            >
                              {char}
                            </span>
                          );
                        })}
                      </span>
                    );
                  })}
                </>
              );
            })()
          ) : (
            brandsPage?.title || "Our Brands"
          )}
        </h1>
        {brandsPage?.subtitle && (
          <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
            {brandsPage.subtitle}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- BRANDS GALLERY WITH FULL-VIEWPORT SECTIONS -->
  <div class="flex flex-col">
    {renderedBrands.map(({ brand, Content, dimensions, isPortrait }, index) => {
      const isReversed = index % 2 === 1;
      return (
        <section
          id={brand.id.replace(/\.md$/, '')}
          class="brand-section relative w-full min-h-[100dvh] flex items-center justify-center py-8 sm:py-12 lg:py-16 scroll-mt-0 transition-colors duration-500"
        >
          <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full my-auto">
            <article class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-10 xl:gap-16 items-center">
              <!-- Imagery Container (Square 1:1 Ratio, No White Frame, object-top for portrait) -->
              <div class={`lg:col-span-6 ${isReversed ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="brand-image-box relative w-full aspect-square max-h-[34vh] sm:max-h-[40vh] lg:max-h-[58vh] max-w-[34vh] sm:max-w-[40vh] lg:max-w-[58vh] overflow-hidden shadow-warm bg-creme-alabaster mx-auto">
                  <img
                    src={brand.data.coverImage}
                    alt={brand.data.name}
                    class={`w-full h-full object-cover ${isPortrait ? 'object-top' : 'object-center'}`}
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Editorial Copy Column -->
              <div class={`brand-content-box lg:col-span-6 space-y-4 sm:space-y-5 lg:space-y-6 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}>
                <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-tight">
                  {brand.data.name}
                </h2>

                <!-- Rendered Markdown Details -->
                <div class="brand-content space-y-4 sm:space-y-5 text-taupe text-sm sm:text-base lg:text-lg font-light leading-relaxed">
                  <Content />
                </div>
              </div>
            </article>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<style>
  /* iPad Pro 13" (1024x1366 / 1032x1376 in portrait & 1366x1024 / 1376x1032 in landscape): Display 2 brands per page */
  @media (min-width: 1024px) and (max-width: 1032px),
         (min-width: 1024px) and (max-width: 1376px) and (min-height: 950px),
         (pointer: coarse) and (min-width: 1024px) and (max-width: 1376px) {
    .brand-section {
      min-height: 50dvh !important;
      padding-top: 1.25rem !important;
      padding-bottom: 1.25rem !important;
    }

    .brand-section .brand-image-box {
      max-height: 25vh !important;
      max-width: 25vh !important;
    }

    .brand-section .brand-content-box {
      row-gap: 0.75rem !important;
    }

    .brand-section h2 {
      font-size: 1.85rem !important;
      line-height: 1.2 !important;
    }

    .brand-section .brand-content {
      row-gap: 0.5rem !important;
    }

    .brand-section .brand-content :global(p) {
      font-size: 0.875rem !important;
      line-height: 1.5 !important;
    }
  }
</style>

<script is:inline>
  // Disable automatic browser scroll restoration when landing with a hash
  if ('scrollRestoration' in history && window.location.hash) {
    history.scrollRestoration = 'manual';
  }

  const alignBrandHash = (smooth = false) => {
    if (!window.location.hash) return;
    const hash = window.location.hash;
    const target = document.querySelector(hash);
    if (!target) return;

    const currentScrollY = window.pageYOffset || document.documentElement.scrollTop;
    const targetRect = target.getBoundingClientRect();
    const targetTop = targetRect.top + currentScrollY;
    const scrollToY = Math.max(0, targetTop);

    window.scrollTo({
      top: scrollToY,
      behavior: smooth ? 'smooth' : 'auto'
    });

    const header = document.getElementById('site-header');
    if (scrollToY > 20) {
      header?.classList.add('-translate-y-full');
    }
  };

  if (window.location.hash) {
    // Stage 1: Instant alignment immediately upon script execution
    alignBrandHash(false);

    // Stage 2: Next frame after initial DOM calculation
    requestAnimationFrame(() => {
      alignBrandHash(false);
    });

    // Stage 3: When DOM is fully interactive
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        alignBrandHash(false);
      });
    }

    // Stage 4: When typography and custom fonts are fully rendered
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        alignBrandHash(false);
      });
    }

    // Stage 5: When all assets (images, stylesheets) finish loading
    window.addEventListener('load', () => {
      alignBrandHash(false);
      setTimeout(() => alignBrandHash(false), 50);
      setTimeout(() => alignBrandHash(false), 200);
      setTimeout(() => alignBrandHash(false), 500);
    });
  }

  window.addEventListener('hashchange', () => {
    alignBrandHash(true);
  });
</script>
