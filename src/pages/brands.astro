---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

// Pre-render case studies for each brand
const renderedBrands = await Promise.all(
  brands.map(async (brand) => {
    const { Content } = await render(brand);
    return {
      brand,
      Content,
    };
  })
);

const brandsPageEntry = await getEntry('pages', 'brands');
const brandsPage = brandsPageEntry?.data;
---

<Layout
  title={brandsPage?.seo?.metaTitle || "Our Brands & Case Studies — TMB Branding | Austin, TX"}
  description={brandsPage?.seo?.metaDescription || "Explore our portfolio of founder-led fashion, beauty, wellness, and lifestyle brands, including Surya by Martha Soffer, N2B4B, Influxious, Recess, L'Une, and OPI."}
  ogImage={brandsPage?.seo?.ogImage}
  currentPath="/brands"
>
  <!-- HERO HEADER (MATCHES SERVICES PAGE) -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16 lg:pt-28 lg:pb-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {brandsPage?.title || "Our Brands"}
        </h1>
        {brandsPage?.subtitle && (
          <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
            {brandsPage.subtitle}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- BRANDS LISTING: FULL VIEWPORT HEIGHT PER SECTION -->
  <div class="flex flex-col">
    {renderedBrands.map(({ brand, Content }, index) => {
      const isVisualRight = index % 2 === 1;

      return (
        <section
          id={brand.id.replace(/\.md$/, '')}
          class="relative w-full min-h-[100dvh] flex items-center justify-center py-8 sm:py-12 lg:py-16 scroll-mt-0 transition-colors duration-500 bg-creme-powder text-espresso"
        >
          <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full my-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 xl:gap-16 items-center">
              
              <!-- Visual Column (Matches height of title + text, borderless) -->
              <div class={`lg:col-span-6 ${isVisualRight ? 'lg:order-2' : 'lg:order-1'}`}>
                <div
                  class="relative aspect-[16/10] sm:aspect-[16/10] lg:aspect-[4/3] max-h-[28vh] sm:max-h-[34vh] lg:max-h-[52vh] overflow-hidden shadow-warm w-full mx-auto bg-creme-alabaster"
                >
                  <img
                    src={brand.data.coverImage}
                    alt={brand.data.name}
                    width={2000}
                    height={1500}
                    class="w-full h-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Editorial Content Column -->
              <div class={`lg:col-span-6 space-y-4 sm:space-y-5 lg:space-y-6 ${isVisualRight ? 'lg:order-1' : 'lg:order-2'}`}>
                <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso leading-tight">
                  {brand.data.name}
                </h2>

                <!-- Rendered Markdown Details -->
                <div class="brand-content space-y-4 sm:space-y-5 text-taupe text-sm sm:text-base lg:text-lg font-light leading-relaxed">
                  <Content />
                </div>
              </div>

            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<script is:inline>
  const alignBrandHash = () => {
    if (!window.location.hash) return;
    const target = document.querySelector(window.location.hash);
    if (!target) return;
    const targetTop = target.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: 'smooth'
    });
  };

  if (window.location.hash) {
    alignBrandHash();
    window.addEventListener('load', () => {
      setTimeout(alignBrandHash, 50);
    });
  }
  window.addEventListener('hashchange', alignBrandHash);
</script>
