---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getCollection, getEntry } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

function parseServiceContent(rawBody: string, fallbackDesc: string) {
  const body = rawBody.replace(/^---[\s\S]*?---\s*/, '').trim();
  const headingMatch = body.match(/^###\s*\*{0,2}(.*?)\*{0,2}\s*$/m);
  const deliverablesHeading = headingMatch ? headingMatch[1].trim() : 'Services Include:';
  const descriptionPart = body.split(/^###/m)[0].trim();
  const description = descriptionPart || fallbackDesc;
  const deliverables = body
    .split('\n')
    .filter((line) => /^[-*•]\s+/.test(line.trim()))
    .map((line) => line.trim().replace(/^[-*•]\s+/, '').trim())
    .filter(Boolean);

  return {
    description,
    deliverablesHeading,
    deliverables,
  };
}

const parsedServices = services.map((service) => {
  let raw = service.body;
  if (!raw) {
    try {
      const filePath = path.resolve(`src/content/services/${service.id}`);
      raw = fs.readFileSync(filePath, 'utf-8');
    } catch {
      raw = '';
    }
  }
  const parsed = parseServiceContent(raw, service.data.shortDescription);
  return {
    service,
    ...parsed,
  };
});

const servicesPageEntry = await getEntry('pages', 'services');
const servicesPage = servicesPageEntry?.data;
const inquiryButtonText = servicesPage?.inquiryButtonText || "Inquire About This Service";
---

<Layout
  title={servicesPage?.seo?.metaTitle || "Digital Marketing Services — TMB Branding | Austin, TX"}
  description={servicesPage?.seo?.metaDescription || "Explore our 6 core capabilities: Social Media Strategy, Strategic Partnerships, Thought Leadership, Email Marketing, Paid Social, and Events & Activations."}
  ogImage={servicesPage?.seo?.ogImage}
  currentPath="/services"
>
  <!-- HERO HEADER (NO BOTTOM BORDER) -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16 lg:pt-28 lg:pb-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {servicesPage?.title || "Digital Marketing Services"}
        </h1>
        {servicesPage?.subtitle && (
          <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
            {servicesPage.subtitle}
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- 6 SERVICES LISTING WITH ALTERNATING BACKGROUND & LAYOUT -->
  <div class="flex flex-col">
    {parsedServices.map(({ service, description, deliverablesHeading, deliverables }, index) => {
      const isEspresso = index % 2 === 1;
      const isVisualRight = index % 2 === 1;

      return (
        <section
          id={service.id.replace(/\.md$/, '')}
          class={`relative w-full min-h-[100dvh] flex items-center justify-center py-8 sm:py-12 lg:py-16 scroll-mt-0 transition-colors duration-500 ${
            isEspresso
              ? 'bg-espresso text-creme-powder'
              : 'bg-creme-powder text-espresso'
          }`}
        >
          <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full my-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-14 xl:gap-16 items-center">
              
              <!-- Visual Column (No Hover Effects) -->
              <div class={`lg:col-span-6 ${isVisualRight ? 'lg:order-2' : 'lg:order-1'}`}>
                <div
                  class={`relative aspect-[16/10] sm:aspect-[16/10] lg:aspect-[4/3] max-h-[26vh] sm:max-h-[30vh] lg:max-h-[52vh] overflow-hidden shadow-warm w-full mx-auto ${
                    isEspresso
                      ? 'bg-espresso-deep border border-white/20'
                      : 'bg-creme-alabaster border border-creme-border'
                  }`}
                >
                  <img
                    src={service.data.coverImage}
                    alt={service.data.title}
                    class="w-full h-full object-cover object-center"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Content Column -->
              <div class={`lg:col-span-6 space-y-4 sm:space-y-5 lg:space-y-6 ${isVisualRight ? 'lg:order-1' : 'lg:order-2'}`}>
                <!-- Title -->
                <h2
                  class={`font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight ${
                    isEspresso ? 'text-white' : 'text-espresso'
                  }`}
                >
                  {service.data.title}
                </h2>

                <!-- Main Description -->
                <p
                  class={`leading-relaxed font-light text-sm sm:text-base lg:text-lg ${
                    isEspresso ? 'text-creme/90' : 'text-taupe'
                  }`}
                >
                  {description}
                </p>

                <!-- Deliverables Presentation Block (No Line, No Bar, Original Font in Bold) -->
                <div class="mt-4 sm:mt-6 lg:mt-8">
                  <!-- Label / Heading -->
                  <h3
                    class={`font-sans font-bold text-sm sm:text-base mb-2.5 sm:mb-3.5 ${
                      isEspresso ? 'text-white' : 'text-espresso'
                    }`}
                  >
                    {deliverablesHeading}
                  </h3>

                  <!-- Deliverables List -->
                  <ul class="space-y-2 sm:space-y-2.5">
                    {deliverables.map((item) => (
                      <li
                        class={`flex items-center space-x-2.5 sm:space-x-3 text-xs sm:text-sm lg:text-base font-light ${
                          isEspresso
                            ? 'text-creme-powder'
                            : 'text-espresso/90'
                        }`}
                      >
                        <span class="w-1.5 h-1.5 rounded-full bg-current flex-shrink-0"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Direct Inquiry Button -->
                <div class="pt-4 sm:pt-6">
                  {isEspresso ? (
                    <a
                      href={`/contact?service=${encodeURIComponent(service.data.title)}`}
                      class="inline-flex items-center justify-center group font-sans px-7 py-3 text-xs tracking-luxury uppercase bg-transparent text-creme-powder border border-white/60 hover:bg-white hover:text-espresso hover:border-white transition-all duration-400 ease-out font-medium"
                    >
                      <span class="relative z-10">{inquiryButtonText}</span>
                      <span class="ml-2.5 transform group-hover:translate-x-1 transition-transform duration-300 ease-out inline-block">
                        &rarr;
                      </span>
                    </a>
                  ) : (
                    <Button
                      href={`/contact?service=${encodeURIComponent(service.data.title)}`}
                      variant="secondary"
                      size="md"
                    >
                      {inquiryButtonText}
                    </Button>
                  )}
                </div>

              </div>

            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>

<script is:inline>
  const alignServiceHash = () => {
    if (!window.location.hash) return;
    const target = document.querySelector(window.location.hash);
    if (!target) return;
    const targetTop = target.getBoundingClientRect().top + window.scrollY;
    window.scrollTo({
      top: Math.max(0, targetTop),
      behavior: 'smooth'
    });
  };

  if (window.location.hash) {
    alignServiceHash();
    window.addEventListener('load', () => {
      setTimeout(alignServiceHash, 50);
    });
  }
  window.addEventListener('hashchange', alignServiceHash);
</script>
