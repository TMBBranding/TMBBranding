---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

function parseServiceContent(rawBody: string, fallbackDesc: string) {
  const body = rawBody.replace(/^---[\s\S]*?---\s*/, '').trim();
  const headingMatch = body.match(/^###\s*\*{0,2}(.*?)\*{0,2}\s*$/m);
  const deliverablesHeading = headingMatch ? headingMatch[1].trim() : 'Services Include:';
  const descriptionPart = body.split(/^###/m)[0].trim();
  const description = descriptionPart || fallbackDesc;
  const deliverables = body
    .split('\n')
    .filter((line) => line.trim().startsWith('- ') || line.trim().startsWith('* '))
    .map((line) => line.trim().replace(/^[-*]\s+/, '').trim())
    .filter(Boolean);

  return {
    description,
    deliverablesHeading,
    deliverables,
  };
}

const parsedServices = services.map((service) => {
  let raw = service.body;
  if (!raw) {
    try {
      const filePath = path.resolve(`src/content/services/${service.id}`);
      raw = fs.readFileSync(filePath, 'utf-8');
    } catch {
      raw = '';
    }
  }
  const parsed = parseServiceContent(raw, service.data.shortDescription);
  return {
    service,
    ...parsed,
  };
});
---

<Layout
  title="Digital Marketing Services — TMB Branding | Austin, TX"
  description="Explore our 6 core capabilities: Social Media Strategy, Strategic Partnerships, Thought Leadership, Email Marketing, Paid Social, and Events & Activations."
  currentPath="/services"
>
  <!-- HERO HEADER (NO BOTTOM BORDER) -->
  <section class="pt-16 pb-12 sm:pt-24 sm:pb-16 lg:pt-28 lg:pb-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          Digital Marketing Services
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          At TMB Branding, we partner with founder-led brands to bring visionary ideas to life. Through strategic storytelling, community building, and digital-first marketing, we craft campaigns and experiences that spark connection and drive growth.
        </p>
      </div>
    </div>
  </section>

  <!-- 6 SERVICES LISTING WITH ALTERNATING BACKGROUND & LAYOUT -->
  <div class="flex flex-col">
    {parsedServices.map(({ service, description, deliverablesHeading, deliverables }, index) => {
      const isTerracotta = index % 2 === 1;
      const isVisualRight = index % 2 === 1;

      return (
        <section
          id={service.id.replace(/\.md$/, '')}
          class={`py-20 sm:py-28 lg:py-32 scroll-mt-24 transition-colors duration-500 ${
            isTerracotta
              ? 'bg-terracotta text-creme-powder'
              : 'bg-creme-powder text-espresso'
          }`}
        >
          <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
              
              <!-- Visual Column -->
              <div class={`lg:col-span-6 ${isVisualRight ? 'lg:order-2' : 'lg:order-1'}`}>
                <div class="relative group">
                  <!-- Ambient Glow -->
                  <div
                    class={`absolute -inset-2 blur-xl transition-opacity duration-700 opacity-0 group-hover:opacity-100 ${
                      isTerracotta
                        ? 'bg-gradient-to-tr from-white/20 via-ocre-soft/20 to-transparent'
                        : 'bg-gradient-to-tr from-ocre-soft/40 via-terracotta-soft/20 to-transparent'
                    }`}
                  ></div>

                  <div
                    class={`relative aspect-[4/3] sm:aspect-[16/11] overflow-hidden shadow-warm group-hover:shadow-warm-lg transition-all duration-500 ${
                      isTerracotta
                        ? 'bg-terracotta-dark border border-white/25'
                        : 'bg-creme-alabaster border border-creme-border'
                    }`}
                  >
                    <img
                      src={service.data.coverImage}
                      alt={service.data.title}
                      class="w-full h-full object-cover object-center slow-zoom"
                      loading="lazy"
                    />
                  </div>
                </div>
              </div>

              <!-- Content Column -->
              <div class={`lg:col-span-6 space-y-6 ${isVisualRight ? 'lg:order-1' : 'lg:order-2'}`}>
                <!-- Title -->
                <h2
                  class={`font-serif text-3xl sm:text-4xl lg:text-5xl leading-tight ${
                    isTerracotta ? 'text-white' : 'text-espresso'
                  }`}
                >
                  {service.data.title}
                </h2>

                <!-- Main Description -->
                <p
                  class={`leading-relaxed font-light text-base sm:text-lg ${
                    isTerracotta ? 'text-creme/90' : 'text-taupe'
                  }`}
                >
                  {description}
                </p>

                <!-- Deliverables Presentation Block with Generous Spacing -->
                <div
                  class={`mt-10 sm:mt-12 pt-7 border-t ${
                    isTerracotta ? 'border-white/20' : 'border-creme-border/80'
                  }`}
                >
                  <!-- Label / Heading -->
                  <div class="flex items-center space-x-3 mb-5">
                    <span
                      class={`w-4 h-[1.5px] ${
                        isTerracotta ? 'bg-ocre' : 'bg-terracotta'
                      }`}
                    ></span>
                    <h3
                      class={`font-serif font-bold text-xl sm:text-2xl tracking-normal ${
                        isTerracotta ? 'text-white' : 'text-espresso'
                      }`}
                    >
                      {deliverablesHeading}
                    </h3>
                  </div>

                  <!-- Deliverables List -->
                  <ul class="space-y-3.5">
                    {deliverables.map((item) => (
                      <li class="flex items-center space-x-3.5 group/item">
                        <span
                          class={`w-1.5 h-1.5 rotate-45 flex-shrink-0 transition-transform duration-300 group-hover/item:scale-125 ${
                            isTerracotta ? 'bg-ocre' : 'bg-terracotta'
                          }`}
                        ></span>
                        <span
                          class={`text-sm sm:text-base font-light tracking-wide transition-colors duration-300 ${
                            isTerracotta
                              ? 'text-creme-powder group-hover/item:text-white'
                              : 'text-espresso/90 group-hover/item:text-espresso'
                          }`}
                        >
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Direct Inquiry Button -->
                <div class="pt-6 sm:pt-8">
                  {isTerracotta ? (
                    <a
                      href={`/contact?service=${encodeURIComponent(service.data.title)}`}
                      class="inline-flex items-center justify-center group font-sans px-7 py-3.5 text-xs tracking-luxury uppercase bg-transparent text-creme-powder border border-white/60 hover:bg-white hover:text-espresso hover:border-white transition-all duration-400 ease-out font-medium"
                    >
                      <span class="relative z-10">Inquire About This Service</span>
                      <span class="ml-2.5 transform group-hover:translate-x-1 transition-transform duration-300 ease-out inline-block">
                        &rarr;
                      </span>
                    </a>
                  ) : (
                    <Button
                      href={`/contact?service=${encodeURIComponent(service.data.title)}`}
                      variant="secondary"
                      size="md"
                    >
                      Inquire About This Service
                    </Button>
                  )}
                </div>

              </div>

            </div>
          </div>
        </section>
      );
    })}
  </div>
</Layout>
