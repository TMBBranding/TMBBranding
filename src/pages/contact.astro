---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';
import type { ContactPageData } from '../content/config';

const contactEntry = await getEntry('pages', 'contact');
if (!contactEntry) {
  throw new Error("Impossible de charger la collection 'pages/contact'");
}
const contact = contactEntry.data as ContactPageData;
---

<Layout
  title={contact.seo.metaTitle}
  description={contact.seo.metaDescription}
  ogImage={contact.seo.ogImage}
  currentPath="/contact"
>
  <!-- VERTICALLY CENTERED CONTACT SECTION -->
  <section class="min-h-[calc(100dvh-4rem)] flex flex-col justify-center py-12 sm:py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full my-auto">
      <div class="max-w-4xl mx-auto space-y-8 sm:space-y-10">
        <!-- Header -->
        <div class="space-y-4 sm:space-y-6">
          <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
            {contact.title}
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans max-w-2xl">
            {contact.subtitle}
          </p>
        </div>

        <!-- Form -->
        <ContactForm
          serviceOptions={contact.serviceOptions}
          budgetOptions={contact.budgetOptions}
        />
      </div>
    </div>
  </section>
</Layout>
