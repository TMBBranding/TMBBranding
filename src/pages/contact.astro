---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';
import type { ContactPageData } from '../content/config';

const contactEntry = await getEntry('pages', 'contact');
if (!contactEntry) {
  throw new Error("Impossible de charger la collection 'pages/contact'");
}
const contact = contactEntry.data as ContactPageData;
---

<Layout
  title={contact.seo.metaTitle}
  description={contact.seo.metaDescription}
  ogImage={contact.seo.ogImage}
  currentPath="/contact"
>
  <!-- HEADER -->
  <section class="pt-16 pb-16 sm:pt-24 sm:pb-20 lg:pt-28 lg:pb-24">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {contact.title}
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          {contact.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN CONTACT GRID -->
  <section class="py-20 sm:py-28 lg:py-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-start">
        
        <!-- Visual Studio Sidebar -->
        <div class="lg:col-span-4 lg:sticky lg:top-24">
          <div class="relative aspect-[4/3] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm">
            <img
              src={contact.seo.ogImage || "/images/uploads/hero-contact.jpg"}
              alt="TMB Branding Austin Studio"
              class="w-full h-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Web3Forms Contact Form Column -->
        <div class="lg:col-span-8">
          <ContactForm
            serviceOptions={contact.serviceOptions}
            budgetOptions={contact.budgetOptions}
          />
        </div>

      </div>
    </div>
  </section>
</Layout>
