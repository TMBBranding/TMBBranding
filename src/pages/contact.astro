---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getEntry } from 'astro:content';
import type { ContactPageData } from '../content/config';

const contactEntry = await getEntry('pages', 'contact');
if (!contactEntry) {
  throw new Error("Impossible de charger la collection 'pages/contact'");
}
const contact = contactEntry.data as ContactPageData;
---

<Layout
  title={contact.seo.metaTitle}
  description={contact.seo.metaDescription}
  ogImage={contact.seo.ogImage}
  currentPath="/contact"
>
  <!-- HEADER -->
  <section class="pt-16 pb-10 sm:pt-24 sm:pb-14 lg:pt-28 lg:pb-16">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-3xl space-y-6">
        <h1 class="font-serif text-5xl sm:text-6xl lg:text-7xl font-normal text-espresso leading-editorial">
          {contact.title}
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-taupe font-light leading-relaxed font-sans">
          {contact.subtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- MAIN CONTACT FORM SECTION -->
  <section class="pb-20 sm:pb-28 lg:pb-32">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="max-w-4xl">
        <ContactForm
          serviceOptions={contact.serviceOptions}
          budgetOptions={contact.budgetOptions}
        />
      </div>
    </div>
  </section>
</Layout>
