---
import Layout from '../layouts/Layout.astro';
import AnimatedLetterE from '../components/AnimatedLetterE.astro';
import { getEntry, getCollection } from 'astro:content';
import type { HomePageData } from '../content/config';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) {
  throw new Error("Failed to load collection 'pages/home'");
}
const home = homeEntry.data as HomePageData;

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const heroVideoUrl = home.hero.video || "/videos/hero-workspace.mp4";
const heroPosterUrl = home.hero.posterImage || "/videos/preview-frame.jpg";
const videoPlayLabel = home.hero.videoPlayLabel || "Play video";
const videoPauseLabel = home.hero.videoPauseLabel || "Pause video";

function getFirstSentence(text?: string): string {
  if (!text) return '';
  const trimmed = text.trim();
  const match = trimmed.match(/^.*?[.!?](?:\s|$)/);
  return match ? match[0].trim() : trimmed;
}
---

<Layout
  title={home.seo.metaTitle}
  description={home.seo.metaDescription}
  ogImage={home.seo.ogImage}
  currentPath="/"
>
  <!-- 1. HERO VIDEO SECTION (Sticky Parallax Curtain) -->
  <section class="sticky top-14 sm:top-16 z-10 w-full h-[calc(100dvh-3.5rem)] sm:h-[calc(100dvh-4rem)] min-h-[540px] flex items-center justify-center overflow-hidden">
    <!-- Background Video with AutoPlay, Loop, Muted, Playsinline -->
    <video
      id="hero-video"
      autoplay
      loop
      muted
      playsinline
      poster={heroPosterUrl}
      class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none"
    >
      <source src={heroVideoUrl} type={heroVideoUrl.endsWith('.mov') ? 'video/quicktime' : 'video/mp4'} />
      {heroVideoUrl !== "/videos/hero-workspace.mp4" && (
        <source src="/videos/hero-workspace.mp4" type="video/mp4" />
      )}
      Your browser does not support the video tag.
    </video>

    <!-- Warm Cinematic Overlay for Contrast & Editorial Legibility -->
    <div class="absolute inset-0 bg-espresso/30" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-espresso/70 via-black/25 to-espresso/35" aria-hidden="true"></div>

    <!-- Centered Editorial Content (Title & Subtitle) -->
    <div class="relative z-20 max-w-5xl mx-auto px-6 sm:px-8 lg:px-12 w-full text-center flex flex-col items-center justify-center space-y-6 sm:space-y-8">
      <!-- Optional Kicker -->
      {home.hero.kicker && (
        <div class="inline-flex items-center space-x-3.5">
          <span class="w-8 h-[1px] bg-white/40"></span>
          <span class="text-[11px] uppercase tracking-kicker text-white/90 font-sans font-semibold drop-shadow-sm">
            {home.hero.kicker}
          </span>
          <span class="w-8 h-[1px] bg-white/40"></span>
        </div>
      )}

      <!-- Main Title with Calligraphic Animated E -->
      <h1 class="hero-title font-serif text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-normal leading-[1.08] tracking-tight text-white drop-shadow-md max-w-4xl mx-auto">
        {(() => {
          const rawTitle = home.hero.title || "Elevating Founder-Led Brands";
          const firstSpace = rawTitle.trimStart().indexOf(' ');
          const firstWord = firstSpace !== -1 ? rawTitle.trimStart().slice(0, firstSpace) : rawTitle;
          const rest = firstSpace !== -1 ? rawTitle.trimStart().slice(firstSpace).trim() : '';

          let italic = '';
          let afterItalic = '';
          if (rest.includes('Founder-Led')) {
            italic = 'Founder-Led';
            afterItalic = rest.split('Founder-Led').slice(1).join('Founder-Led').trim();
          } else {
            afterItalic = rest;
          }

          return (
            <>
              <span class="relative inline-block align-baseline">
                <span>{firstWord}</span>
                <span class="elevating-trail absolute inset-0 pointer-events-none select-none text-white" aria-hidden="true">{firstWord}</span>
              </span>{italic ? <> <span class="italic whitespace-nowrap">{italic}</span><br />{afterItalic}</> : <><br />{afterItalic}</>}
            </>
          );
        })()}
      </h1>

      <!-- Subtitle -->
      <p class="hero-subtitle text-base sm:text-lg md:text-xl text-creme-powder/90 font-light leading-relaxed max-w-2xl mx-auto font-sans drop-shadow-sm">
        {home.hero.subtitle}
      </p>
    </div>

    <!-- Play / Pause Ultra-Discreet White Button (Bottom Right) -->
    <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 z-30">
      <button
        id="hero-video-toggle"
        type="button"
        data-play-label={videoPlayLabel}
        data-pause-label={videoPauseLabel}
        class="group w-5.5 h-5.5 sm:w-6 sm:h-6 rounded-full bg-white/70 hover:bg-white text-espresso/80 hover:text-espresso backdrop-blur-xs shadow-xs flex items-center justify-center transition-all duration-300 focus:outline-none focus:ring-1 focus:ring-white/80 cursor-pointer"
        aria-label={videoPauseLabel}
        title={videoPauseLabel}
      >
        <!-- Pause Icon (shown when playing) -->
        <svg
          id="hero-video-pause-icon"
          class="w-3 h-3 sm:w-3.5 sm:h-3.5 fill-current transition-transform duration-200 group-hover:scale-110"
          viewBox="0 0 24 24"
        >
          <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z" />
        </svg>

        <!-- Play Icon (shown when paused) -->
        <svg
          id="hero-video-play-icon"
          class="w-4 h-4 sm:w-4.5 sm:h-4.5 fill-current hidden transition-transform duration-200 group-hover:scale-110"
          viewBox="0 0 24 24"
        >
          <path d="M8 5v14l11-7z" />
        </svg>
      </button>
    </div>
  </section>

  <!-- 2. SCROLLING CONTENT WRAPPER (Slides up over the fixed hero video) -->
  <div class="relative z-20 shadow-[0_-25px_50px_rgba(0,0,0,0.4)] bg-creme-powder">
    <!-- 2. SERVICES GRID -->
  <section class="py-24 sm:py-32 bg-espresso text-creme-powder border-b border-espresso-deep/40">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <!-- Section Header (Centered, no button) -->
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <h2 class="font-serif text-4xl sm:text-5xl text-creme">
          {home.servicesSectionTitle || "Boutique Brand & Digital Marketing"}
        </h2>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.slice(0, 6).map((service) => {
          const serviceAnchor = `/services#${service.id.replace(/\.md$/, '')}`;
          return (
            <article class="group bg-creme-powder border border-creme-powder shadow-warm-xs hover:shadow-warm-lg transition-all duration-500 overflow-hidden flex flex-col justify-between">
              <div class="space-y-6">
                <!-- Service Image Ratio 16/10 -->
                <a href={serviceAnchor} class="block relative aspect-[16/10] overflow-hidden bg-creme-alabaster">
                  <img
                    src={service.data.cardImage || service.data.coverImage}
                    alt={service.data.title}
                    class="w-full h-full object-cover object-center slow-zoom"
                    loading="lazy"
                  />
                </a>

                <!-- Content -->
                <div class="px-7 pt-1 pb-8 space-y-3 bg-creme-powder">
                  <h3 class="font-serif text-2xl text-taupe">
                    <a
                      href={serviceAnchor}
                      class="focus:outline-none transition-colors duration-300 text-taupe group-hover:text-espresso hover:text-espresso"
                    >
                      {service.data.title}
                    </a>
                  </h3>
                  <p class="text-taupe text-sm leading-relaxed font-light line-clamp-3">
                    {getFirstSentence(service.data.shortDescription)}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 3. TRUSTED BY VISIONARY FOUNDERS & CLIENT TESTIMONIALS -->
  <section class="py-24 sm:py-32 bg-creme-powder">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 space-y-20 sm:space-y-28">
      
      <!-- Top: Brands Showcase -->
      <div class="space-y-12">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso">
            {home.brandsSectionTitle || "Trusted by Visionary Founders"}
          </h2>
        </div>

        <!-- Monochrome Logos Grid on Black Background, No Borders, Prominent Centered Logos -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 items-center">
          {brands.map((b) => (
            <a
              href={`/brands#${b.id.replace(/\.md$/, '')}`}
              class="group bg-black p-5 sm:p-6 flex items-center justify-center h-28 sm:h-32 transition-all duration-300 shadow-warm-xs hover:shadow-warm hover:-translate-y-0.5 hover:bg-neutral-950"
              title={b.data.name}
              aria-label={b.data.name}
            >
              <img
                src={b.data.logoImage}
                alt={`${b.data.name} logo`}
                class="max-h-14 sm:max-h-16 max-w-[85%] w-auto h-auto object-contain brightness-0 invert opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom: Testimonials Auto-Carousel -->
      <div class="max-w-3xl mx-auto">
        <div id="testimonials-carousel" class="grid grid-cols-1 items-center">
          {home.testimonials.map((item, idx) => (
            <div
              class={`testimonial-slide col-start-1 row-start-1 w-full text-center px-4 flex flex-col justify-center items-center transition-opacity duration-700 ease-in-out ${
                idx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
              }`}
              data-index={idx}
            >
              <p class="font-serif text-xl sm:text-2xl lg:text-3xl text-espresso leading-relaxed font-light italic">
                "{item.quote}"
              </p>
              <h3 class="font-sans text-xs sm:text-sm uppercase tracking-luxury font-semibold text-taupe mt-6">
                {item.author}
              </h3>
            </div>
          ))}
        </div>

        <!-- Carousel Dots -->
        <div class="flex justify-center items-center space-x-2.5 mt-8">
          {home.testimonials.map((_, idx) => (
            <button
              type="button"
              class={`testimonial-dot h-1.5 transition-all duration-300 ${
                idx === 0 ? 'w-8 bg-taupe' : 'w-2 bg-creme-border hover:bg-taupe'
              }`}
              data-target={idx}
              aria-label={`Go to slide ${idx + 1}`}
            ></button>
          ))}
        </div>
      </div>

    </div>
  </section>
  </div>
</Layout>

<script is:inline>
  // --- 1. HERO VIDEO CONTROLLER (AutoPlay & Pause/Play Button) ---
  const heroVideo = document.getElementById('hero-video');
  const heroVideoToggle = document.getElementById('hero-video-toggle');
  const heroPauseIcon = document.getElementById('hero-video-pause-icon');
  const heroPlayIcon = document.getElementById('hero-video-play-icon');

  if (heroVideo && heroVideoToggle && heroPauseIcon && heroPlayIcon) {
    const playLabel = heroVideoToggle.getAttribute('data-play-label') || 'Play video';
    const pauseLabel = heroVideoToggle.getAttribute('data-pause-label') || 'Pause video';

    const updatePlayPauseUI = (isPaused) => {
      if (isPaused) {
        heroPauseIcon.classList.add('hidden');
        heroPlayIcon.classList.remove('hidden');
        heroVideoToggle.setAttribute('aria-label', playLabel);
        heroVideoToggle.setAttribute('title', playLabel);
      } else {
        heroPlayIcon.classList.add('hidden');
        heroPauseIcon.classList.remove('hidden');
        heroVideoToggle.setAttribute('aria-label', pauseLabel);
        heroVideoToggle.setAttribute('title', pauseLabel);
      }
    };

    heroVideoToggle.addEventListener('click', () => {
      if (heroVideo.paused) {
        heroVideo.play().catch(() => {});
      } else {
        heroVideo.pause();
      }
    });

    heroVideo.addEventListener('play', () => updatePlayPauseUI(false));
    heroVideo.addEventListener('pause', () => updatePlayPauseUI(true));

    // Force muted & start autoplay
    heroVideo.muted = true;
    const playPromise = heroVideo.play();
    if (playPromise !== undefined) {
      playPromise
        .then(() => updatePlayPauseUI(false))
        .catch(() => {
          // In case browser policy blocked autoplay, update UI accordingly
          updatePlayPauseUI(true);
        });
    }
  }

  // --- 2. TESTIMONIALS CAROUSEL ---
  const testimonialSlides = document.querySelectorAll('.testimonial-slide');
  const testimonialDots = document.querySelectorAll('.testimonial-dot');
  let currentTestimonialIdx = 0;
  let testimonialTimer;

  function showTestimonial(index) {
    testimonialSlides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
      }
    });

    testimonialDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('w-2', 'bg-creme-border');
        dot.classList.add('w-8', 'bg-taupe');
      } else {
        dot.classList.remove('w-8', 'bg-taupe');
        dot.classList.add('w-2', 'bg-creme-border');
      }
    });

    currentTestimonialIdx = index;
  }

  function nextTestimonial() {
    if (testimonialSlides.length === 0) return;
    const next = (currentTestimonialIdx + 1) % testimonialSlides.length;
    showTestimonial(next);
  }

  function startTestimonialsAutoPlay() {
    stopTestimonialsAutoPlay();
    testimonialTimer = setInterval(nextTestimonial, 4500);
  }

  function stopTestimonialsAutoPlay() {
    if (testimonialTimer) clearInterval(testimonialTimer);
  }

  testimonialDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      showTestimonial(i);
      startTestimonialsAutoPlay();
    });
  });

  const carouselBox = document.getElementById('testimonials-carousel');
  if (carouselBox) {
    carouselBox.addEventListener('mouseenter', stopTestimonialsAutoPlay);
    carouselBox.addEventListener('mouseleave', startTestimonialsAutoPlay);
  }

  if (testimonialSlides.length > 1) {
    startTestimonialsAutoPlay();
  }
</script>

<style>
  /* 1. Synchronized editorial entrance of the hero title */
  .hero-title {
    will-change: transform, opacity, filter;
    animation: heroTitleRise 1.9s cubic-bezier(0.33, 1, 0.68, 1) 0.3s both;
  }

  @keyframes heroTitleRise {
    0% {
      opacity: 0.05;
      transform: translateY(0.35em);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0px);
    }
  }

  /* 2. Upward ascending trail: graceful, floating elevation echo */
  /* Perfectly fluid, single continuous ease-out curve, zero hitch, mirrors rising motion */
  .elevating-trail {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    user-select: none;
    opacity: 0;
    color: inherit;
    will-change: transform, opacity, filter;
    animation: elevatingAscend 5s cubic-bezier(0.33, 1, 0.68, 1) 1.25s forwards;
  }

  @keyframes elevatingAscend {
    0% {
      opacity: 0.55;
      transform: translateY(0);
      filter: blur(1px);
    }
    100% {
      opacity: 0;
      transform: translateY(-1.0em);
      filter: blur(8px);
    }
  }

  /* 3. Subtitle: smooth fade-in as the elevating trail dissolves and vanishes (~3.1s) */
  .hero-subtitle {
    will-change: opacity, transform;
    animation: heroSubtitleFadeIn 1.2s cubic-bezier(0.25, 1, 0.5, 1) 3.1s both;
  }

  @keyframes heroSubtitleFadeIn {
    0% {
      opacity: 0;
      transform: translateY(14px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Mobile: accentuated motion amplitudes (< 640px) */
  @media (max-width: 639px) {
    .hero-title {
      animation-name: heroTitleRiseMobile;
    }
    .elevating-trail {
      animation-name: elevatingAscendMobile;
    }
  }

  @keyframes heroTitleRiseMobile {
    0% {
      opacity: 0.05;
      transform: translateY(0.45em);
      filter: blur(10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0px);
    }
  }

  @keyframes elevatingAscendMobile {
    0% {
      opacity: 0.55;
      transform: translateY(0);
      filter: blur(1px);
    }
    100% {
      opacity: 0;
      transform: translateY(-1.85em);
      filter: blur(8px);
    }
  }

  /* Accessibility: respect user preference for reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-title,
    .hero-subtitle {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
    }
    .elevating-trail {
      display: none !important;
    }
  }
</style>
