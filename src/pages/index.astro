---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';
import type { HomePageData } from '../content/config';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) {
  throw new Error("Impossible de charger la collection 'pages/home'");
}
const home = homeEntry.data as HomePageData;

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout
  title={home.seo.metaTitle}
  description={home.seo.metaDescription}
  ogImage={home.seo.ogImage}
  currentPath="/"
>
  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[calc(100dvh-3.5rem)] sm:min-h-[calc(100dvh-4rem)] flex items-center py-8 sm:py-12 lg:py-14 overflow-hidden border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Editorial Copy -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-8">
          <!-- Kicker (Optional) -->
          {home.hero.kicker && (
            <div class="inline-flex items-center space-x-3.5">
              <span class="w-8 h-[1px] bg-ocre"></span>
              <span class="text-[11px] uppercase tracking-kicker text-ocre font-sans font-semibold">
                {home.hero.kicker}
              </span>
            </div>
          )}

          <!-- Main Title -->
          <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-7xl xl:text-8xl font-normal leading-[1.05] tracking-tight text-espresso">
            {home.hero.title.includes('Founder-Led') ? (
              <>
                {home.hero.title.split('Founder-Led')[0]}
                <span class="italic whitespace-nowrap">Founder-Led</span>
                {home.hero.title.split('Founder-Led')[1]}
              </>
            ) : (
              home.hero.title
            )}
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg md:text-xl text-taupe font-light leading-relaxed max-w-2xl font-sans">
            {home.hero.subtitle}
          </p>


        </div>

        <!-- Right Hero Visual -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-full max-w-md lg:max-w-none">
            <!-- Subtle warm background glow/halo -->
            <div class="absolute -inset-3 bg-gradient-to-tr from-ocre-soft/50 via-terracotta-soft/30 to-transparent blur-xl opacity-70"></div>

            <div class="relative aspect-[4/5] max-h-[65vh] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={home.seo.ogImage || "/images/uploads/hero-home.jpg"}
                alt="TMB Branding Studio — Austin TX"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. GRILLE DE SERVICES -->
  <section class="py-24 sm:py-32 bg-terracotta text-creme-powder border-b border-terracotta-dark/30">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <!-- Section Header (Centered, no button) -->
      <div class="text-center mb-16 max-w-3xl mx-auto">
        <h2 class="font-serif text-4xl sm:text-5xl text-creme">
          {home.servicesSectionTitle || "Comprehensive Digital Marketing"}
        </h2>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.slice(0, 6).map((service) => {
          const serviceAnchor = `/services#${service.id.replace(/\.md$/, '')}`;
          return (
            <article class="group bg-creme-powder border border-white shadow-warm-xs hover:shadow-warm-lg transition-all duration-500 overflow-hidden flex flex-col justify-between">
              <div class="space-y-6">
                <!-- Service Image Ratio 16/10 -->
                <a href={serviceAnchor} class="block relative aspect-[16/10] overflow-hidden bg-creme-alabaster">
                  <img
                    src={service.data.coverImage}
                    alt={service.data.title}
                    class="w-full h-full object-cover object-center slow-zoom"
                    loading="lazy"
                  />
                </a>

                <!-- Content -->
                <div class="px-7 pt-1 pb-8 space-y-3">
                  <h3 class="font-serif text-2xl text-espresso">
                    <a
                      href={serviceAnchor}
                      class="focus:outline-none transition-colors duration-300 text-espresso group-hover:text-terracotta hover:text-terracotta"
                    >
                      {service.data.title}
                    </a>
                  </h3>
                  <p class="text-taupe text-sm leading-relaxed font-light line-clamp-3">
                    {service.data.shortDescription}
                  </p>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 3. TRUSTED BY VISIONARY FOUNDERS & CLIENT TESTIMONIALS -->
  <section class="py-24 sm:py-32 bg-creme-powder">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 space-y-20 sm:space-y-28">
      
      <!-- Top: Brands Showcase -->
      <div class="space-y-12">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-espresso">
            {home.brandsSectionTitle || "Trusted by Visionary Founders"}
          </h2>
        </div>

        <!-- Monochrome Logos Grid on Black Background, No Borders, Prominent Centered Logos -->
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 sm:gap-6 items-center">
          {brands.map((b) => (
            <a
              href={`/brands#${b.id.replace(/\.md$/, '')}`}
              class="group bg-black p-5 sm:p-6 flex items-center justify-center h-28 sm:h-32 transition-all duration-300 shadow-warm-xs hover:shadow-warm hover:-translate-y-0.5 hover:bg-neutral-950"
              title={b.data.name}
              aria-label={b.data.name}
            >
              <img
                src={b.data.logoImage}
                alt={`${b.data.name} logo`}
                class="max-h-14 sm:max-h-16 max-w-[85%] w-auto h-auto object-contain brightness-0 invert opacity-90 group-hover:opacity-100 transition-opacity duration-300"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom: Testimonials Auto-Carousel -->
      <div class="max-w-3xl mx-auto">
        <div id="testimonials-carousel" class="grid grid-cols-1 items-center">
          {home.testimonials.map((item, idx) => (
            <div
              class={`testimonial-slide col-start-1 row-start-1 w-full text-center px-4 flex flex-col justify-center items-center transition-opacity duration-700 ease-in-out ${
                idx === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
              }`}
              data-index={idx}
            >
              <p class="font-serif text-xl sm:text-2xl lg:text-3xl text-espresso leading-relaxed font-light italic">
                "{item.quote}"
              </p>
              <h3 class="font-sans text-xs sm:text-sm uppercase tracking-luxury font-semibold text-terracotta mt-6">
                {item.author}
              </h3>
            </div>
          ))}
        </div>

        <!-- Carousel Dots -->
        <div class="flex justify-center items-center space-x-2.5 mt-8">
          {home.testimonials.map((_, idx) => (
            <button
              type="button"
              class={`testimonial-dot h-1.5 transition-all duration-300 ${
                idx === 0 ? 'w-8 bg-taupe' : 'w-2 bg-creme-border hover:bg-taupe'
              }`}
              data-target={idx}
              aria-label={`Aller au témoignage ${idx + 1}`}
            ></button>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>

<script is:inline>
  const testimonialSlides = document.querySelectorAll('.testimonial-slide');
  const testimonialDots = document.querySelectorAll('.testimonial-dot');
  let currentTestimonialIdx = 0;
  let testimonialTimer;

  function showTestimonial(index) {
    testimonialSlides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'pointer-events-auto', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'pointer-events-auto', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
      }
    });

    testimonialDots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.remove('w-2', 'bg-creme-border');
        dot.classList.add('w-8', 'bg-taupe');
      } else {
        dot.classList.remove('w-8', 'bg-taupe');
        dot.classList.add('w-2', 'bg-creme-border');
      }
    });

    currentTestimonialIdx = index;
  }

  function nextTestimonial() {
    if (testimonialSlides.length === 0) return;
    const next = (currentTestimonialIdx + 1) % testimonialSlides.length;
    showTestimonial(next);
  }

  function startTestimonialsAutoPlay() {
    stopTestimonialsAutoPlay();
    testimonialTimer = setInterval(nextTestimonial, 4500);
  }

  function stopTestimonialsAutoPlay() {
    if (testimonialTimer) clearInterval(testimonialTimer);
  }

  testimonialDots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      showTestimonial(i);
      startTestimonialsAutoPlay();
    });
  });

  const carouselBox = document.getElementById('testimonials-carousel');
  if (carouselBox) {
    carouselBox.addEventListener('mouseenter', stopTestimonialsAutoPlay);
    carouselBox.addEventListener('mouseleave', startTestimonialsAutoPlay);
  }

  if (testimonialSlides.length > 1) {
    startTestimonialsAutoPlay();
  }
</script>
