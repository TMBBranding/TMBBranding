---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';
import type { HomePageData } from '../content/config';

const homeEntry = await getEntry('pages', 'home');
if (!homeEntry) {
  throw new Error("Impossible de charger la collection 'pages/home'");
}
const home = homeEntry.data as HomePageData;

const allServices = await getCollection('services');
const services = allServices.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const allBrands = await getCollection('brands');
const brands = allBrands.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<Layout
  title={home.seo.metaTitle}
  description={home.seo.metaDescription}
  ogImage={home.seo.ogImage}
  currentPath="/"
>
  <!-- 1. HERO SECTION -->
  <section class="relative min-h-[calc(100dvh-4rem)] sm:min-h-[calc(100dvh-5rem)] flex items-center py-8 sm:py-12 lg:py-14 overflow-hidden border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Editorial Copy -->
        <div class="lg:col-span-7 space-y-6 sm:space-y-8">
          <!-- Kicker (Optional) -->
          {home.hero.kicker && (
            <div class="inline-flex items-center space-x-3.5">
              <span class="w-8 h-[1px] bg-ocre"></span>
              <span class="text-[11px] uppercase tracking-kicker text-ocre font-sans font-semibold">
                {home.hero.kicker}
              </span>
            </div>
          )}

          <!-- Main Title -->
          <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-7xl xl:text-8xl font-normal leading-[1.05] tracking-tight text-espresso">
            {home.hero.title.includes('Founder-Led') ? (
              <>
                {home.hero.title.split('Founder-Led')[0]}
                <span class="italic whitespace-nowrap">Founder-Led</span>
                {home.hero.title.split('Founder-Led')[1]}
              </>
            ) : (
              home.hero.title
            )}
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg md:text-xl text-taupe font-light leading-relaxed max-w-2xl font-sans">
            {home.hero.subtitle}
          </p>


        </div>

        <!-- Right Hero Visual -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative group w-full max-w-md lg:max-w-none">
            <!-- Subtle warm background glow/halo -->
            <div class="absolute -inset-3 bg-gradient-to-tr from-ocre-soft/50 via-terracotta-soft/30 to-transparent blur-xl opacity-70 group-hover:opacity-100 transition-opacity duration-700"></div>

            <div class="relative aspect-[4/5] max-h-[65vh] overflow-hidden bg-creme-alabaster border border-creme-border shadow-warm-lg">
              <img
                src={home.seo.ogImage || "/images/uploads/hero-home.jpg"}
                alt="TMB Branding Studio — Austin TX"
                class="w-full h-full object-cover object-center slow-zoom"
                loading="eager"
              />
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. GRILLE DE SERVICES -->
  <section class="py-24 sm:py-32 bg-terracotta text-creme-powder border-b border-terracotta-dark/30">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <!-- Section Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 space-y-4 md:space-y-0">
        <div>
          <h2 class="font-serif text-4xl sm:text-5xl text-creme">
            Comprehensive Digital Marketing
          </h2>
        </div>
        <a
          href="/services"
          class="inline-flex items-center text-xs uppercase tracking-luxury text-creme/90 hover:text-white font-medium underline underline-offset-8 decoration-creme/50 hover:decoration-white transition-colors"
        >
          <span>View All 6 Disciplines</span>
          <span class="ml-2">&rarr;</span>
        </a>
      </div>

      <!-- Services Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {services.slice(0, 6).map((service) => (
          <article class="group bg-creme-powder border border-white/20 hover:border-white/50 shadow-warm-xs hover:shadow-warm-lg transition-all duration-500 overflow-hidden flex flex-col justify-between">
            <div class="space-y-6">
              <!-- Service Image Ratio 16/10 -->
              <div class="relative aspect-[16/10] overflow-hidden bg-creme-alabaster">
                <img
                  src={service.data.coverImage}
                  alt={service.data.title}
                  class="w-full h-full object-cover object-center slow-zoom"
                  loading="lazy"
                />
              </div>

              <!-- Content -->
              <div class="px-7 pt-1 pb-4 space-y-3">
                <h3 class="font-serif text-2xl text-espresso group-hover:text-terracotta transition-colors duration-300">
                  {service.data.title}
                </h3>
                <p class="text-taupe text-sm leading-relaxed font-light line-clamp-3">
                  {service.data.shortDescription}
                </p>
              </div>
            </div>

            <!-- Footer Action -->
            <div class="px-7 pb-7 pt-2 border-t border-creme-border/50">
              <a
                href="/services"
                class="inline-flex items-center text-[10px] uppercase tracking-luxury text-espresso group-hover:text-terracotta font-medium transition-colors"
              >
                <span>Learn Details</span>
                <span class="ml-2 transform group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. BANDEAU MARQUES / PARTENAIRES -->
  <section class="py-20 sm:py-24 bg-creme-alabaster border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center max-w-2xl mx-auto mb-14 space-y-3">
        <h2 class="font-serif text-3xl sm:text-4xl text-espresso">
          Trusted by Visionary Founders
        </h2>
        <p class="text-xs sm:text-sm text-taupe font-light">
          From seed-stage disruptors to household names across fashion, beauty, wellness, and lifestyle.
        </p>
      </div>

      <!-- Monochrome / Warm Logos Grid -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6 sm:gap-8 items-center">
        {brands.map((b) => (
          <a
            href="/brands"
            class="group bg-creme-powder/80 hover:bg-creme-powder border border-creme-border/70 hover:border-terracotta/40 p-5 flex flex-col items-center justify-center space-y-3 h-28 transition-all duration-300 shadow-warm-xs hover:shadow-warm"
            title={b.data.name}
          >
            <img
              src={b.data.logoImage}
              alt={`${b.data.name} logo`}
              class="max-h-10 w-auto object-contain opacity-75 group-hover:opacity-100 transition-opacity duration-300"
              loading="lazy"
            />
            <span class="text-[9px] uppercase tracking-wider text-taupe-light font-medium truncate max-w-full">
              {b.data.name.split(' by ')[0]}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. SECTION TÉMOIGNAGES (LAURIE PAYTON, DALLAS MORENO, REESE PLATT) -->
  <section class="py-24 sm:py-32 border-b border-creme-border/60">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="text-center max-w-xl mx-auto mb-16">
        <h2 class="font-serif text-4xl sm:text-5xl text-espresso">
          What Founders Say
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        {home.testimonials.map((item) => (
          <div class="bg-creme-alabaster/70 border border-creme-border p-8 sm:p-10 flex flex-col justify-between space-y-8 relative shadow-warm-xs hover:shadow-warm transition-shadow duration-300">
            <!-- Decorative Serif Quote Mark -->
            <span class="font-serif text-6xl text-ocre/35 leading-none select-none absolute top-6 right-6">
              &ldquo;
            </span>

            <p class="font-serif text-lg sm:text-xl text-espresso leading-relaxed font-light italic relative z-10">
              "{item.quote}"
            </p>

            <div class="pt-6 border-t border-creme-border/80 flex items-center justify-between">
              <div>
                <h3 class="font-sans text-xs uppercase tracking-luxury font-semibold text-espresso">
                  {item.author}
                </h3>
                <p class="text-[10px] text-taupe uppercase tracking-wider mt-0.5">
                  {item.role}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. FINAL INVITATION CTA -->
  <section class="py-24 sm:py-32 bg-espresso text-creme-powder text-center relative overflow-hidden">
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-terracotta/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-ocre/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-3xl mx-auto px-6 sm:px-8 lg:px-12 space-y-8">
      <span class="text-[10px] uppercase tracking-kicker text-ocre font-sans font-semibold block">
        Start a Project
      </span>
      <h2 class="font-serif text-4xl sm:text-5xl lg:text-6xl text-creme font-normal leading-tight">
        Ready to tell your brand story with intention?
      </h2>
      <p class="text-taupe-light text-base sm:text-lg max-w-xl mx-auto font-light leading-relaxed">
        We partner with founder-led ventures who value craftsmanship and authentic connection. Let's create something memorable together.
      </p>
      <div class="pt-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center px-10 py-4 text-xs uppercase tracking-luxury font-medium text-espresso bg-creme-powder hover:bg-white shadow-warm-lg hover:shadow-warm-xl transition-all duration-300 ease-out"
        >
          <span>Contact Us for More Information</span>
          <span class="ml-2.5">&rarr;</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
