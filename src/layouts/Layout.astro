---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  currentPath?: string;
  noindex?: boolean;
}

const {
  title = 'TMB Branding | Founder-Led Branding Agency',
  description = 'Boutique branding and digital agency elevating visionary founder-led fashion, beauty, and lifestyle brands to cultural authority.',
  ogImage = '/images/uploads/hero-home.jpg',
  currentPath = Astro.url.pathname,
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://tmbbranding.com');

// Load global settings from Decap CMS (src/content/pages/settings.md)
const settingsEntry = await getEntry('pages', 'settings');
const settings = settingsEntry?.data;
const siteLanguage = settings?.siteLanguage || 'en';

// Load dynamic theme colors from Decap CMS (src/content/pages/theme.md)
const themeEntry = await getEntry('pages', 'theme');
const theme = themeEntry?.data as any;

function hexToRgb(hex?: string, fallback = '0 0 0') {
  if (!hex) return fallback;
  const clean = hex.replace('#', '').trim();
  if (clean.length === 3) {
    const r = parseInt(clean[0] + clean[0], 16);
    const g = parseInt(clean[1] + clean[1], 16);
    const b = parseInt(clean[2] + clean[2], 16);
    return `${r} ${g} ${b}`;
  }
  const r = parseInt(clean.substring(0, 2), 16) || 0;
  const g = parseInt(clean.substring(2, 4), 16) || 0;
  const b = parseInt(clean.substring(4, 6), 16) || 0;
  return `${r} ${g} ${b}`;
}

const cPowder = theme?.creme?.powder || '#FAF7F2';
const cAlabaster = theme?.creme?.alabaster || '#F3EFEA';
const cBorder = theme?.creme?.border || '#E4DDD4';

const tDefault = theme?.terracotta?.default || '#9E6742';
const tDark = theme?.terracotta?.dark || '#7D4B2A';
const tLight = theme?.terracotta?.light || '#BD835C';

const eDefault = theme?.espresso?.default || '#382820';
const eDeep = theme?.espresso?.deep || '#1C1513';

const taupeDefault = theme?.taupe?.default || '#6B5C55';
const taupeLight = theme?.taupe?.light || '#94847D';

const ocreDefault = theme?.ocre?.default || '#C29B72';
const ocreLight = theme?.ocre?.light || '#D8B58F';

const cPowderRgb = hexToRgb(cPowder, '250 247 242');
const cAlabasterRgb = hexToRgb(cAlabaster, '243 239 234');
const cBorderRgb = hexToRgb(cBorder, '228 221 212');

const tDefaultRgb = hexToRgb(tDefault, '158 103 66');
const tDarkRgb = hexToRgb(tDark, '125 75 42');
const tLightRgb = hexToRgb(tLight, '189 131 92');

const eDefaultRgb = hexToRgb(eDefault, '56 40 32');
const eDeepRgb = hexToRgb(eDeep, '28 21 19');

const taupeDefaultRgb = hexToRgb(taupeDefault, '107 92 85');
const taupeLightRgb = hexToRgb(taupeLight, '148 132 125');

const ocreDefaultRgb = hexToRgb(ocreDefault, '194 155 114');
const ocreLightRgb = hexToRgb(ocreLight, '216 181 143');
---

<!doctype html>
<html lang={siteLanguage} class="bg-creme-powder text-espresso antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <!-- Decap CMS Theme Color Variables -->
    <style is:inline set:html={`
      :root {
        --color-creme: ${cPowder};
        --color-creme-powder: ${cPowder};
        --color-alabaster: ${cAlabaster};
        --color-creme-alabaster: ${cAlabaster};
        --color-border: ${cBorder};
        --color-creme-border: ${cBorder};

        --color-terracotta: ${tDefault};
        --color-terracotta-dark: ${tDark};
        --color-terracotta-light: ${tLight};
        --color-cognac: ${tDefault};
        --color-cognac-dark: ${tDark};
        --color-cognac-light: ${tLight};

        --color-espresso: ${eDefault};
        --color-espresso-deep: ${eDeep};

        --color-taupe: ${taupeDefault};
        --color-taupe-light: ${taupeLight};

        --color-ocre: ${ocreDefault};
        --color-ocre-light: ${ocreLight};
        --color-champagne: ${ocreDefault};
        --color-champagne-light: ${ocreLight};

        --color-creme-powder-rgb: ${cPowderRgb};
        --color-creme-alabaster-rgb: ${cAlabasterRgb};
        --color-creme-border-rgb: ${cBorderRgb};

        --color-terracotta-rgb: ${tDefaultRgb};
        --color-terracotta-dark-rgb: ${tDarkRgb};
        --color-terracotta-light-rgb: ${tLightRgb};
        --color-cognac-rgb: ${tDefaultRgb};
        --color-cognac-dark-rgb: ${tDarkRgb};
        --color-cognac-light-rgb: ${tLightRgb};

        --color-espresso-rgb: ${eDefaultRgb};
        --color-espresso-deep-rgb: ${eDeepRgb};

        --color-taupe-rgb: ${taupeDefaultRgb};
        --color-taupe-light-rgb: ${taupeLightRgb};

        --color-ocre-rgb: ${ocreDefaultRgb};
        --color-ocre-light-rgb: ${ocreLightRgb};
        --color-champagne-rgb: ${ocreDefaultRgb};
        --color-champagne-light-rgb: ${ocreLightRgb};
      }
    `}></style>

    <!-- SEO, Open Graph, Twitter & JSON-LD Structured Data -->
    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      canonicalURL={canonicalURL}
      noindex={noindex}
      ogLocale={settings?.ogLocale}
      companyName={settings?.companyName || settings?.brandName}
      founderName={settings?.founderName}
      founderTitle={settings?.founderTitle}
      companyAddressLocality={settings?.location}
      phone={settings?.phone}
    />

    <!-- Preconnect to Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Italiana&family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700&family=Syne:wght@500;600;700;800&display=swap" />

    <!-- Netlify Identity Widget -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>

    <!-- Netlify Identity Login Listener: Automatic redirect to /admin/ upon login -->
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", function(user) {
          if (!user) {
            window.netlifyIdentity.on("login", function() {
              document.location.href = "/admin/";
            });
          }
        });
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-creme-powder text-espresso">
    <!-- Main Global Navbar -->
    <Navbar currentPath={currentPath} />

    <!-- Page Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Global Footer -->
    <Footer />
  </body>
</html>
